---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import { GOOGLE_MAP_URL, SITE, STRUCTURED_DATA_IDS } from '../site.config';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: BreadcrumbItem[];
  /** When true, keeps a page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '',
  ogImage = '/og-default.png',
  ogImageAlt = `${SITE.name}: ${SITE.tagline}`,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs,
  noindex = false,
} = Astro.props;

const siteTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const normalizePath = (value: string) => {
  const normalized = value.replace(/^\/+|\/+$/g, '');
  if (!normalized) return '/';
  return normalized.includes('.') ? `/${normalized}` : `/${normalized}/`;
};
const canonical = new URL(normalizePath(path), Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const ogImageType = ogImage.endsWith('.png')
  ? 'image/png'
  : ogImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const resolvedOgImageWidth = ogImageWidth ?? (ogImage === '/og-default.png' ? 1200 : undefined);
const resolvedOgImageHeight = ogImageHeight ?? (ogImage === '/og-default.png' ? 630 : undefined);

const sameAs = [GOOGLE_MAP_URL, ...Object.values(SITE.social)].filter(Boolean);
const openingHoursSpecification = SITE.schema.publishOpeningHours
  ? SITE.hours
      .filter((hours) => hours.opens && hours.closes)
      .map((hours) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: hours.schemaDays.map((day) => `https://schema.org/${day}`),
        opens: hours.opens,
        closes: hours.closes,
      }))
  : [];

const websiteSchema = {
  '@type': 'WebSite',
  '@id': STRUCTURED_DATA_IDS.website,
  url: `${SITE.domain}/`,
  name: SITE.name,
  description: SITE.description,
  publisher: { '@id': STRUCTURED_DATA_IDS.clinic },
  inLanguage: 'en-US',
};

const businessSchema = {
  '@type': 'MedicalClinic',
  '@id': STRUCTURED_DATA_IDS.clinic,
  name: SITE.name,
  legalName: SITE.legalName,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'NPI',
    value: SITE.organizationNpi,
  },
  description: SITE.description,
  disambiguatingDescription: SITE.disambiguatingDescription,
  url: `${SITE.domain}/`,
  logo: new URL('/images/luma-logo-mark.png', SITE.domain).toString(),
  image: [
    new URL('/images/luma-logo-mark.png', SITE.domain).toString(),
    new URL('/images/hero-child.jpg', SITE.domain).toString(),
    new URL('/og-default.png', SITE.domain).toString(),
  ],
  slogan: SITE.tagline,
  telephone: SITE.contact.phoneE164,
  email: SITE.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.latitude,
    longitude: SITE.geo.longitude,
  },
  hasMap: GOOGLE_MAP_URL,
  medicalSpecialty: 'Pediatric',
  isAcceptingNewPatients: false,
  additionalProperty: {
    '@type': 'PropertyValue',
    name: 'Opening status',
    value: SITE.status,
  },
  areaServed: SITE.areasServed.map((city) => ({
    '@type': 'City',
    name: city,
    containedInPlace: { '@type': 'State', name: 'Texas' },
  })),
  ...(openingHoursSpecification.length ? { openingHoursSpecification } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  ...(SITE.showProviderProfile
    ? {
        employee: { '@id': STRUCTURED_DATA_IDS.physician },
        founder: { '@id': STRUCTURED_DATA_IDS.physician },
      }
    : {}),
};

const physicianSchema = SITE.showProviderProfile
  ? {
      '@type': 'Physician',
      '@id': STRUCTURED_DATA_IDS.physician,
      name: SITE.provider.name,
      url: `${SITE.domain}/about/`,
      disambiguatingDescription: `Board-certified pediatrician and founder of ${SITE.name} in McKinney, Texas.`,
      image: new URL('/images/provider-headshot.jpg', SITE.domain).toString(),
      medicalSpecialty: 'Pediatric',
      jobTitle: SITE.provider.role,
      knowsLanguage: SITE.provider.languages,
      worksFor: { '@id': STRUCTURED_DATA_IDS.clinic },
      alumniOf: SITE.provider.education.map((education) => ({
        '@type': 'EducationalOrganization',
        name: education,
      })),
    }
  : null;

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: siteTitle,
  description,
  isPartOf: { '@id': STRUCTURED_DATA_IDS.website },
  about: { '@id': STRUCTURED_DATA_IDS.clinic },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImageUrl,
    ...(resolvedOgImageWidth ? { width: resolvedOgImageWidth } : {}),
    ...(resolvedOgImageHeight ? { height: resolvedOgImageHeight } : {}),
  },
  inLanguage: 'en-US',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteSchema,
    businessSchema,
    ...(physicianSchema ? [physicianSchema] : []),
    webPageSchema,
  ],
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(normalizePath(b.path), SITE.domain).toString(),
      })),
    }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {SITE.analytics.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.analytics.googleSiteVerification} />
    )}
    {SITE.analytics.bingSiteVerification && (
      <meta name="msvalidate.01" content={SITE.analytics.bingSiteVerification} />
    )}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} Blog & Parent Guides`}
      href={`${SITE.domain}/rss.xml`}
    />
    <meta name="theme-color" content="#0B1D3A" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    {resolvedOgImageWidth && (
      <meta property="og:image:width" content={String(resolvedOgImageWidth)} />
    )}
    {resolvedOgImageHeight && (
      <meta property="og:image:height" content={String(resolvedOgImageHeight)} />
    )}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD: linked website, MedicalClinic, Physician, and page entities -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    {import.meta.env.PROD && SITE.analytics.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.ga4MeasurementId}`}
        />
        <script is:inline define:vars={{ ga4Id: SITE.analytics.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', ga4Id);

          document.addEventListener('click', function (event) {
            var element = event.target instanceof Element
              ? event.target.closest('a[href]')
              : null;
            if (!element || typeof window.gtag !== 'function') return;

            var href = element.getAttribute('href') || '';
            var contactMethod = '';
            if (href.indexOf('tel:') === 0) contactMethod = 'phone';
            else if (href.indexOf('sms:') === 0) contactMethod = 'sms';
            else if (href.indexOf('mailto:') === 0) contactMethod = 'email';
            else if (href.indexOf('google.com/maps/dir') !== -1) contactMethod = 'directions';

            if (!contactMethod) return;
            window.gtag('event', 'contact_action', {
              contact_method: contactMethod,
              page_path: window.location.pathname,
            });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCTABar />

    <!-- Motion: scroll-driven reveal via IntersectionObserver (Jakub Krehel's enter recipe).
         Plus sticky-nav shadow-on-scroll toggle. Respects prefers-reduced-motion. -->
    <script is:inline>
      (function () {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

        var header = document.querySelector('header');
        if (header) {
          var onScroll = function () {
            if (window.scrollY > 8) header.classList.add('nav-scrolled');
            else header.classList.remove('nav-scrolled');
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      })();
    </script>
  </body>
</html>
