---
/**
 * TEMPORARY pre-opening holding layout.
 *
 * Minimal, neutral chrome for the pre-opening holding page and the retained
 * legal pages. Intentionally does NOT use the full-site Header/Footer/nav,
 * MedicalBusiness JSON-LD, analytics, or MobileCTABar so nothing implies the
 * practice is operational or solicits patients.
 *
 * RESTORE: when the practice launches, point the retained pages back to
 * `BaseLayout.astro` and restore `src/pages/_index.full.astro` as the homepage
 * (see docs / the holding-page commit message for full restore steps).
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Luma Pediatrics | Future Practice in McKinney',
  description =
    'Luma Pediatrics is a future pediatric practice in McKinney, Texas. The practice is not currently providing medical services or accepting patients.',
  path = '',
} = Astro.props;

const canonical = new URL(path, Astro.site).toString();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* TEMPORARY holding page: keep the whole site out of search + archives.
        (GitHub Pages static hosting can't set an X-Robots-Tag response header,
        so this meta tag is the authoritative signal.) */}
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B1D3A" />

    {/* Neutral Open Graph / Twitter — makes no claim that the clinic is open,
        accepting patients, or offering services. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* No analytics / GA4 / advertising pixels and no MedicalBusiness or
        Physician structured data while the practice is pre-opening. */}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header class="holding-header">
      <a href="/" class="holding-logo" aria-label={`${SITE.name} — Home`}>
        <Logo variant="horizontal" size={52} />
      </a>
    </header>

    <main id="main" class="holding-main">
      <slot />
    </main>

    <footer class="holding-footer">
      <p class="holding-footer__links">
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/accessibility">Accessibility</a>
      </p>
      <p class="holding-footer__copy">© {year} {SITE.name}. All rights reserved.</p>
    </footer>

    <style>
      /* Neutralize the full-site scroll-reveal animations so content is always
         visible without JS (and per "avoid unnecessary animations"). */
      .reveal,
      .fade-up {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        animation: none !important;
      }

      .holding-header {
        display: flex;
        justify-content: center;
        padding: 2rem 1.5rem 0;
      }
      .holding-logo {
        text-decoration: none;
      }
      .holding-main {
        max-width: 44rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 3rem;
      }
      .holding-footer {
        max-width: 44rem;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 2.5rem;
        border-top: 1px solid var(--color-border-soft);
        text-align: center;
        color: var(--color-muted-foreground);
        font-size: 0.8125rem;
      }
      .holding-footer__links {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        align-items: center;
      }
      .holding-footer__links a {
        color: var(--color-primary);
        font-weight: 600;
        text-decoration: none;
      }
      .holding-footer__links a:hover {
        text-decoration: underline;
      }
      .holding-footer__copy {
        margin-top: 0.5rem;
      }
      @media (min-width: 768px) {
        .holding-header {
          padding-top: 3rem;
        }
      }
    </style>
  </body>
</html>
