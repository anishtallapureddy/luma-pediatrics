---
import { DOSING_MEDICINES } from '../utils/dosing';
---
<section
  id="dosage-calculator"
  data-dosing-calculator
  aria-labelledby="dosing-calculator-title"
  class="max-w-4xl mx-auto scroll-mt-32 px-4 sm:px-6 lg:px-8 py-10"
>
  <div class="rounded-[var(--radius-card)] bg-[var(--color-card)] p-6 sm:p-8 ring-1 ring-[var(--color-border-soft)]">
    <span class="eyebrow eyebrow-sun">Check the bottle first</span>
    <h2 id="dosing-calculator-title" class="mt-4 text-3xl text-[var(--color-primary)]">
      Children’s liquid dosing calculator
    </h2>
    <p class="mt-4 text-[var(--color-foreground)]/85 leading-relaxed">
      For ages <strong>2–11</strong> and the two liquid strengths below only.
      This tool looks up the product-label weight band; it does not prescribe medicine
      or calculate infant or adult doses. Follow your child’s current provider’s guidance
      and the warnings on your bottle.
    </p>

    <fieldset class="mt-6 grid min-w-0 gap-5 sm:grid-cols-2">
      <legend class="sr-only">Medicine and weight details</legend>
      <div class="sm:col-span-2">
        <label for="dose-medicine" class="block text-sm font-semibold">Medicine and liquid strength</label>
        <select id="dose-medicine" data-dose-medication aria-describedby="dose-strength-help dose-safety dose-error" class="dose-control">
          <option value="">Choose a medicine</option>
          {Object.entries(DOSING_MEDICINES).map(([value, medicine]) => (
            <option value={value}>{medicine.shortLabel} — {medicine.concentration}</option>
          ))}
        </select>
        <p id="dose-strength-help" class="mt-2 text-sm text-[var(--color-muted-foreground)]">
          Supported bottle strengths: acetaminophen <strong>{DOSING_MEDICINES.acetaminophen.concentration}</strong>;
          ibuprofen <strong>{DOSING_MEDICINES.ibuprofen.concentration}</strong>.
        </p>
      </div>
      <div>
        <label for="dose-age" class="block text-sm font-semibold">Age in completed years</label>
        <input id="dose-age" data-dose-age type="number" min="0" step="1" inputmode="numeric" autocomplete="off" aria-describedby="dose-error" class="dose-control" />
      </div>
      <div>
        <label for="dose-unit" class="block text-sm font-semibold">Weight unit</label>
        <select id="dose-unit" data-dose-unit aria-describedby="dose-weight-help dose-error" class="dose-control">
          <option value="lb">Pounds (lb)</option>
          <option value="kg">Kilograms (kg)</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label for="dose-weight" class="block text-sm font-semibold">Current weight</label>
        <input id="dose-weight" data-dose-weight type="number" min="0" step="any" inputmode="decimal" autocomplete="off" aria-describedby="dose-weight-help dose-error" class="dose-control" />
        <p id="dose-weight-help" class="mt-2 text-sm text-[var(--color-muted-foreground)]">
          Use a recent measured weight. Fractional pounds stay in the lower whole-pound band.
          Changing units clears the weight so you can re-enter it correctly.
        </p>
      </div>
      <label class="sm:col-span-2 flex items-start gap-3 text-sm leading-relaxed" for="dose-confirm">
        <input id="dose-confirm" data-dose-confirm type="checkbox" class="mt-1 shrink-0 accent-[var(--color-primary)]" aria-describedby="dose-safety dose-error" />
        <span>I checked the bottle: it matches the medicine and liquid strength selected above.</span>
      </label>
    </fieldset>

    <p id="dose-safety" class="mt-5 text-sm text-[var(--color-muted-foreground)] leading-relaxed">
      Do not use these volumes for infant drops, other strengths, or combination products.
      Ask a provider or pharmacist first if your child has allergies, health conditions,
      takes other medicine, or is dehydrated. Do not combine or alternate medicines without
      your provider’s instructions. Use a marked oral syringe or the product’s dosing device,
      not a kitchen spoon.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <button type="button" data-dose-calculate class="min-h-11 rounded-full bg-[var(--color-primary)] px-6 py-3 font-semibold text-[var(--color-primary-foreground)] hover:brightness-110 focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2">
        Check label dose
      </button>
      <button type="button" data-dose-reset class="min-h-11 rounded-full border border-[var(--color-border-soft)] px-6 py-3 font-semibold text-[var(--color-primary)] hover:bg-[var(--color-muted)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2">
        Clear details
      </button>
    </div>
    <p id="dose-error" data-dose-error hidden role="alert" class="mt-5 font-semibold text-[var(--color-destructive)]"></p>
    <div data-dose-result hidden role="status" aria-live="polite" aria-atomic="true" class="mt-6 rounded-2xl bg-[var(--color-muted)] p-5 ring-1 ring-[var(--color-border-soft)]">
      <p data-dose-result-medicine class="font-semibold text-[var(--color-primary)]"></p>
      <p class="mt-3 text-2xl font-bold text-[var(--color-primary)]">One dose: <output data-dose-volume></output></p>
      <p data-dose-details class="mt-2 text-sm text-[var(--color-foreground)]/85"></p>
      <p data-dose-timing class="mt-2 text-sm font-semibold"></p>
      <p class="mt-3 text-sm text-[var(--color-muted-foreground)]">This is a label lookup, not individualized medical advice. If the bottle or your provider’s directions differ, ask before giving medicine.</p>
    </div>
    <p class="mt-5 text-xs text-[var(--color-muted-foreground)]">
      Age and weight stay in this calculator in your browser; they are not saved or submitted.
      Read the full{' '}
      <a href="https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=ce0a1fbc-7345-462b-b0da-c7149bdc288c" target="_blank" rel="noopener noreferrer" class="underline">acetaminophen label</a>
      {' '}and{' '}
      <a href="https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=f2609308-17bf-4bcb-84b2-d17f3fd35958" target="_blank" rel="noopener noreferrer" class="underline">ibuprofen label</a>.
    </p>
  </div>
</section>

<script>
  import { calculateDosing } from '../utils/dosing';

  document.querySelectorAll<HTMLElement>('[data-dosing-calculator]').forEach((root) => {
    const medication = root.querySelector<HTMLSelectElement>('[data-dose-medication]');
    const age = root.querySelector<HTMLInputElement>('[data-dose-age]');
    const weight = root.querySelector<HTMLInputElement>('[data-dose-weight]');
    const unit = root.querySelector<HTMLSelectElement>('[data-dose-unit]');
    const confirm = root.querySelector<HTMLInputElement>('[data-dose-confirm]');
    const calculate = root.querySelector<HTMLButtonElement>('[data-dose-calculate]');
    const reset = root.querySelector<HTMLButtonElement>('[data-dose-reset]');
    const error = root.querySelector<HTMLElement>('[data-dose-error]');
    const result = root.querySelector<HTMLElement>('[data-dose-result]');
    const medicineLabel = root.querySelector<HTMLElement>('[data-dose-result-medicine]');
    const volume = root.querySelector<HTMLOutputElement>('[data-dose-volume]');
    const details = root.querySelector<HTMLElement>('[data-dose-details]');
    const timing = root.querySelector<HTMLElement>('[data-dose-timing]');
    if (!medication || !age || !weight || !unit || !confirm || !calculate || !reset || !error || !result || !medicineLabel || !volume || !details || !timing) {
      throw new Error('Dosing calculator controls are missing.');
    }
    const fields = { medication, ageYears: age, weight, weightUnit: unit, strengthConfirmed: confirm };
    const clearResult = () => {
      result.hidden = true;
      error.hidden = true;
      error.textContent = '';
      medicineLabel.textContent = '';
      volume.textContent = '';
      details.textContent = '';
      timing.textContent = '';
      Object.values(fields).forEach((field) => field.removeAttribute('aria-invalid'));
    };
    const checkDose = () => {
      clearResult();
      const dose = calculateDosing({
        medication: medication.value,
        ageYears: age.value.trim() ? Number(age.value) : NaN,
        weight: weight.value.trim() ? Number(weight.value) : NaN,
        weightUnit: unit.value,
        strengthConfirmed: confirm.checked,
      });
      if (dose.kind !== 'dose') {
        error.textContent = dose.message;
        error.hidden = false;
        if (dose.kind === 'invalid') {
          fields[dose.field].setAttribute('aria-invalid', 'true');
          fields[dose.field].focus();
        }
        return;
      }
      medicineLabel.textContent = `${dose.medicationLabel} — ${dose.concentration}`;
      volume.textContent = `${dose.milliliters} mL`;
      details.textContent = `${dose.milligrams} mg per dose · weight band ${dose.weightBand}`;
      timing.textContent = `${dose.interval}. No more than ${dose.maximumDoses} doses in 24 hours.`;
      result.hidden = false;
    };
    Object.values(fields).forEach((field) => {
      field.addEventListener('input', clearResult);
      field.addEventListener('change', clearResult);
    });
    medication.addEventListener('change', () => { confirm.checked = false; });
    unit.addEventListener('change', () => { weight.value = ''; });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && (event.target === age || event.target === weight)) {
        event.preventDefault();
        checkDose();
      }
    });
    calculate.addEventListener('click', checkDose);
    reset.addEventListener('click', () => {
      medication.value = '';
      age.value = '';
      weight.value = '';
      unit.value = 'lb';
      confirm.checked = false;
      clearResult();
      medication.focus();
    });
  });
</script>

<style>
  .dose-control {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 0.75rem;
    color: var(--color-foreground);
    background: var(--color-background);
  }
  .dose-control:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .dose-control[aria-invalid='true'] {
    border-color: var(--color-destructive);
  }
</style>
