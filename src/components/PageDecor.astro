---
/**
 * PageDecor - reusable, elegant background decorations that echo the brand poster:
 * gold-outlined clouds, sage leaf sprays, and scattered gold sparkles.
 *
 * Drop inside any `.page-hero`, `.brand-hero`, or `.campaign-panel` container
 * (or any positioned section) as the very first child. All decorations are
 * absolutely positioned and aria-hidden.
 *
 * Variants control density:
 *  - "soft"  (default) : clouds, leaves, and stars for primary page heroes
 *  - "lush"            : more decoration, for the homepage hero
 *  - "minimal"         : adds stars only; page heroes retain their shared rings
 *
 * Keep dense reading surfaces undecorated.
 */
import SparkleField from './SparkleField.astro';

interface Props {
  variant?: 'soft' | 'lush' | 'minimal';
  sparkles?: number;
}

const { variant = 'soft', sparkles } = Astro.props;
const sparkleCount = sparkles ?? (variant === 'lush' ? 12 : variant === 'minimal' ? 6 : 8);
const showClouds = variant !== 'minimal';
const showLeaves = variant !== 'minimal';
---
<div class={`page-decor page-decor--${variant}`} aria-hidden="true">
  {showClouds && (
    <>
      <div class="brand-cloud cloud-left"></div>
      <div class="brand-cloud cloud-right"></div>
    </>
  )}
  {showLeaves && (
    <>
      <div class="botanical-spray leaf-left">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="botanical-spray leaf-right">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </>
  )}
  <SparkleField count={sparkleCount} class="z-0" />
</div>

<style>
  .page-decor {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  @media (max-width: 639px) {
    .page-decor--soft :global(.brand-cloud) {
      opacity: 0.46;
    }

    .page-decor--soft :global(.botanical-spray) {
      opacity: 0.34;
    }
  }
</style>
