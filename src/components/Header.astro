---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { SITE } from '../site.config';
import { getMedicalScheduling } from '../utils/serviceScheduling';

const medicalScheduling = getMedicalScheduling(SITE);
// Hide the "Home" link in the visible nav (the logo is the Home affordance)
const navLinks = SITE.nav.filter((n) => n.href !== '/');
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const resourcePaths = [
  '/resources',
  '/blog',
  '/health-watch',
  '/vaccines',
  '/dosing-charts',
];
const isActive = (href: string) => {
  const path = normalizePath(href);
  if (path === '/services' && ['/newborn-care', '/meet-and-greet', '/well-child-visits'].includes(currentPath)) return true;
  if (path === '/resources') {
    return resourcePaths.some(
      (resourcePath) =>
        currentPath === resourcePath ||
        currentPath.startsWith(`${resourcePath}/`),
    );
  }
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---
<header
  class="sticky top-0 z-40 bg-[var(--color-background)] border-b border-[var(--color-border-soft)] [transition:box-shadow_var(--duration-base)_var(--ease-fluid),border-color_var(--duration-base)_var(--ease-fluid)]"
>
  <div class="site-container">
    <div class="flex min-h-20 items-center justify-between gap-3 py-2">
      <a
        href="/"
         class="header-logo no-underline [transition:transform_var(--duration-fast)_var(--ease-fluid)] hover:scale-[1.02]"
         aria-label={`${SITE.name}, Home`}
       >
         <Logo variant="horizontal" size={60} />
      </a>

      <nav aria-label="Primary" class="hidden xl:flex items-center gap-0.5">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'px-2 py-2 rounded-full text-[0.9375rem] text-[var(--color-foreground)] no-underline font-medium whitespace-nowrap hover:bg-[rgba(200,153,90,0.10)] [transition:background-color_var(--duration-fast)_var(--ease-fluid),color_var(--duration-fast)_var(--ease-fluid)]',
              isActive(href) && 'bg-[rgba(200,153,90,0.14)]',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div
          class="hidden xl:flex items-center gap-1.5"
          role="group"
          aria-label="Contact Luma Pediatrics for general questions, not medical advice"
        >
          <a
            href={SITE.contact.phoneHref}
            class="header-contact-btn"
            aria-label={`Call ${SITE.name} for general questions at ${SITE.contact.phone}`}
            title={`General questions only: call ${SITE.contact.phone}`}
          >
            <Icon name="lucide:phone" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
            <span>Call us</span>
          </a>
          <a
            href={SITE.contact.smsHref}
            class="header-contact-btn"
            aria-label={`Text ${SITE.name} for general questions at ${SITE.contact.phone}`}
            title={`General questions only: text ${SITE.contact.phone}`}
          >
            <Icon name="lucide:message-circle" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
            <span>Text us</span>
          </a>
        </div>
        {medicalScheduling.appointments.enabled && (
          <Button
            href={medicalScheduling.appointments.href}
            class="header-schedule-btn whitespace-nowrap xl:px-4"
            ariaLabel={medicalScheduling.appointments.label}
          >
            <span>Schedule<span class="hidden sm:inline">&nbsp;an Appointment</span></span>
          </Button>
        )}

        <button
          type="button"
          class="xl:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--color-primary)] bg-transparent border border-[var(--color-border-soft)] hover:bg-[rgba(200,153,90,0.10)] [transition:background-color_var(--duration-fast)_var(--ease-fluid)]"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-mobile-menu-toggle
        >
          <Icon name="lucide:menu" class="w-5 h-5 mobile-menu-icon-open" stroke-width="2" aria-hidden="true" />
          <Icon name="lucide:x" class="w-5 h-5 mobile-menu-icon-close" stroke-width="2" aria-hidden="true" />
        </button>
      </div>
    </div>

    <!-- Mobile drawer - slides down below the header when toggled. -->
    <div id="mobile-menu" class="xl:hidden mobile-menu-panel" data-mobile-menu data-open="true">
      <div class="mobile-menu-inner">
        <nav aria-label="Primary mobile" class="flex flex-col py-2">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'px-2 py-3 rounded-lg text-base text-[var(--color-foreground)] no-underline font-medium hover:bg-[rgba(200,153,90,0.10)] [transition:background-color_var(--duration-fast)_var(--ease-fluid)]',
                isActive(href) && 'bg-[rgba(200,153,90,0.14)]',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
  <div class="border-t border-[var(--color-border-soft)] bg-[var(--color-muted)]">
    <div class="site-container py-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-xs sm:text-sm text-[var(--color-foreground)]/85">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:sparkles" class="w-3.5 h-3.5 text-[var(--color-sun)]" stroke-width="1.8" aria-hidden="true" />
        <strong>{SITE.status}.</strong>
      </span>
      <span>{medicalScheduling.enabled ? 'Now booking online.' : 'Not currently open or scheduling appointments.'}</span>
    </div>
  </div>
</header>

<noscript>
  <style is:inline>
    [data-mobile-menu-toggle] { display: none !important; }
    #mobile-menu nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  </style>
</noscript>

<style>
  /* Smooth height collapse using grid-template-rows trick - no JS height math needed,
     and the panel still measures correctly when content changes. */
  .mobile-menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-base, 220ms) var(--ease-fluid, ease);
    overflow: hidden;
  }
  .mobile-menu-panel[data-open="true"] {
    grid-template-rows: 1fr;
  }
  .mobile-menu-inner {
    min-height: 0;
    border-top: 1px solid var(--color-border-soft);
  }
  @media (min-width: 1280px) {
    .mobile-menu-panel { display: none; }
  }
  .header-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-button);
    background: var(--color-card);
    color: var(--color-primary);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-fluid);
  }
  .header-contact-btn:hover { background: var(--color-muted); }
  /* Icon swap - show menu icon when closed, X when open. */
  [data-mobile-menu-toggle] .mobile-menu-icon-close { display: none; }
  [data-mobile-menu-toggle][aria-expanded="true"] .mobile-menu-icon-open { display: none; }
  [data-mobile-menu-toggle][aria-expanded="true"] .mobile-menu-icon-close { display: inline-block; }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.querySelector('[data-mobile-menu-toggle]');
    var panel = document.querySelector('[data-mobile-menu]');
    if (!toggle || !panel) return;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.inert = !open;
      if (open) panel.setAttribute('data-open', 'true');
      else panel.removeAttribute('data-open');
    }
    setOpen(false);

    toggle.addEventListener('click', function () {
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    // Close when a nav link is tapped
    panel.addEventListener('click', function (e) {
      var target = e.target;
      while (target && target !== panel) {
        if (target.tagName === 'A') { setOpen(false); break; }
        target = target.parentNode;
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close when viewport grows past mobile breakpoint
    var mq = window.matchMedia('(min-width: 1280px)');
    var onChange = function () {
      if (!mq.matches) return;
      var focusedHref = panel.contains(document.activeElement)
        ? document.activeElement.getAttribute('href') : null;
      setOpen(false);
      if (focusedHref) {
        var destination = Array.from(document.querySelectorAll('nav[aria-label="Primary"] a'))
          .find(function (link) { return link.getAttribute('href') === focusedHref; })
          || document.querySelector('.header-logo');
        if (destination) destination.focus();
      }
    };
    mq.addEventListener('change', onChange);
  })();
</script>
