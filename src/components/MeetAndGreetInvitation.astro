---
import Button from './Button.astro';
import { meetAndGreet } from '../data/services';
---
<aside
  id={meetAndGreet.slug}
  aria-labelledby="meet-and-greet-invitation-heading"
  class="mt-10 scroll-mt-32 rounded-[var(--radius-card)] bg-[var(--color-muted)] p-6 md:p-8"
>
  <span class="eyebrow">{meetAndGreet.title}</span>
  <h2 id="meet-and-greet-invitation-heading" class="mt-4 text-2xl md:text-3xl tracking-tight">
    Considering Luma? Get to know your pediatrician.
  </h2>
  <p class="mt-3 text-[var(--color-foreground)]/80 leading-relaxed">{meetAndGreet.full}</p>
  <div class="mt-5">
    <Button href={meetAndGreet.nextStep.href} variant="secondary">{meetAndGreet.nextStep.label}</Button>
  </div>
</aside>
