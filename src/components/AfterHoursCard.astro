---
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';

const { onCallActive } = SITE.afterHours;
---
<aside class="after-hours-card rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-8">
  <div class="flex items-center gap-2 text-[var(--color-primary)]">
    <Icon name="lucide:clock" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
    <span class="eyebrow eyebrow-sun">After-hours care</span>
  </div>
  <h2 class="mt-4 text-2xl md:text-3xl font-extrabold tracking-tight">
    Need Help After Hours?
  </h2>
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl bg-[rgba(231,108,112,0.10)] border border-[rgba(231,108,112,0.40)] p-4">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-coral)]">Emergency</p>
      <p class="mt-2 text-[var(--color-foreground)]/90 leading-relaxed">
        For a life-threatening emergency, <strong>call 911</strong> or go to the nearest emergency department.
      </p>
    </div>
    <div class="rounded-xl bg-[var(--color-muted)] p-4">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">Urgent</p>
      <p class="mt-2 text-[var(--color-foreground)]/90 leading-relaxed">
        Call <a href={SITE.contact.phoneHref} class="font-semibold">{SITE.contact.phone}</a> to reach our on-call physician{onCallActive ? '.' : ` once we open ${SITE.openingWindow}.`}
      </p>
    </div>
    <div class="rounded-xl bg-[var(--color-muted)] p-4">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">Can wait</p>
      <p class="mt-2 text-[var(--color-foreground)]/90 leading-relaxed">
        Message us through the Patient Portal. Portal messages are not monitored for emergencies.
      </p>
    </div>
  </div>
  <a href="/after-hours/" class="mt-5 inline-flex min-h-11 items-center gap-1.5 font-semibold text-[var(--color-primary)] underline underline-offset-4">
    See all after-hours options
    <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
  </a>
</aside>
