---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import AreasServed from '../components/AreasServed.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';

/**
 * Pre-opening contact page. Call, text, and email are for general information
 * only; no scheduling, patient registration, or clinical intake is available.
 */
---
<BaseLayout
  title="Contact Luma Pediatrics | McKinney, TX"
  path="/contact"
  description="General contact information, future location, and planned office hours for Luma Pediatrics, opening late 2026 in McKinney and welcoming nearby North Texas communities."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]}
>
  <section class="page-hero py-14 md:py-20 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">Contact</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">Stay connected as we prepare to open.</h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Future practice opening late 2026 in McKinney.
      </p>
      <p class="mt-7 text-lg text-[var(--color-foreground)]/80 leading-relaxed max-w-2xl mx-auto">
        Call, text, or email for general information about the future practice. We are not currently open or scheduling appointments.
      </p>
    </div>
  </section>

  <!-- General contact and future location -->
  <section class="pb-16 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <article class="card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] p-7 md:p-8">
        <span
          class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[var(--color-muted)] text-[var(--color-primary)] mb-5 ring-1 ring-inset ring-[rgba(11,29,58,0.08)]"
          style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
          aria-hidden="true"
        >
          <Icon name="lucide:phone" class="w-6 h-6" stroke-width="1.6" />
        </span>
        <h2 class="text-2xl font-extrabold">General information and future location</h2>
        <p class="mt-3 text-[var(--color-foreground)]/80 leading-relaxed">
          Reach out with general questions about the planned practice, services, or opening updates.
          Please do not send medical information. For current care, contact your existing healthcare provider.
        </p>
          <dl class="mt-5 space-y-2.5 text-base">
            <div class="flex items-start gap-3">
              <Icon name="lucide:phone" class="w-5 h-5 text-[var(--color-primary)] mt-1" stroke-width="1.6" aria-hidden="true" />
              <span class="font-semibold">{SITE.contact.phone}</span>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="lucide:mail" class="w-5 h-5 text-[var(--color-primary)] mt-1" stroke-width="1.6" aria-hidden="true" />
              <a href={SITE.contact.emailHref} class="no-underline">{SITE.contact.email}</a>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="lucide:map-pin" class="w-5 h-5 text-[var(--color-primary)] mt-1" stroke-width="1.6" aria-hidden="true" />
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wide text-[var(--color-muted-foreground)]">Future location</span>
                <address class="not-italic text-[var(--color-foreground)]/85 leading-relaxed">
                  {SITE.address.street}<br />
                  {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
                </address>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="lucide:clock" class="w-5 h-5 text-[var(--color-primary)] mt-1" stroke-width="1.6" aria-hidden="true" />
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wide text-[var(--color-muted-foreground)]">Planned office hours</span>
                {SITE.hours.map(({ day, time }) => (
                  <div><span class="font-semibold">{day}</span> · {time}</div>
                ))}
              </div>
            </div>
          </dl>

          <section
            id="sms-disclosure"
            class="mt-5 rounded-2xl bg-[var(--color-muted)] p-5 ring-1 ring-inset ring-[var(--color-border-soft)]"
            aria-labelledby="sms-disclosure-title"
          >
            <div class="flex items-center gap-2 text-[var(--color-primary)]">
              <Icon name="lucide:message-circle" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
              <h3 id="sms-disclosure-title" class="text-base font-bold">Text Luma Pediatrics</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-foreground)]/85">
              By texting Luma Pediatrics at 469-200-1151, you agree to receive customer care text
              messages from Luma Pediatrics. Message frequency varies. Message and data rates may
              apply. Reply HELP for help or STOP to opt out.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-foreground)]/85">
              <strong>Privacy Policy:</strong>
              {' '}<a
                href="https://github.com/anishtallapureddy/luma-pediatrics/blob/main/src/pages/privacy.astro"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold break-all"
              >https://github.com/anishtallapureddy/luma-pediatrics/blob/main/src/pages/privacy.astro</a>
            </p>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-foreground)]/85">
              <strong>Terms &amp; Conditions:</strong>
              {' '}<a
                href="https://github.com/anishtallapureddy/luma-pediatrics/blob/main/src/pages/terms.astro"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold break-all"
              >https://github.com/anishtallapureddy/luma-pediatrics/blob/main/src/pages/terms.astro</a>
            </p>
          </section>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <a
              href={SITE.contact.phoneHref}
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-4 text-sm font-semibold text-white no-underline"
              aria-label={`Call ${SITE.name} at ${SITE.contact.phone}`}
            >
              <Icon name="lucide:phone" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
              Call us
            </a>
            <a
              href={SITE.contact.smsHref}
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-4 text-sm font-semibold text-white no-underline"
              aria-label={`Text ${SITE.name} at ${SITE.contact.phone}`}
            >
              <Icon name="lucide:message-circle" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
              Text us
            </a>
          </div>

          <div class="mt-6 overflow-hidden rounded-xl ring-1 ring-inset ring-[rgba(11,29,58,0.08)]">
            <iframe
              title={`Map of ${SITE.name} in ${SITE.address.city}, ${SITE.address.region}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${SITE.geo.latitude},${SITE.geo.longitude}&z=16&output=embed`}
              class="block w-full h-56 border-0"
            ></iframe>
          </div>
          <a
            href={`https://www.google.com/maps/dir/?api=1&destination=${SITE.geo.latitude},${SITE.geo.longitude}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] no-underline hover:underline"
          >
            <Icon name="lucide:map-pin" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
            Get directions
          </a>
      </article>
    </div>
  </section>

  <!-- AREAS WE SERVE -->
  <section class="pb-16 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <AreasServed />
    </div>
  </section>

</BaseLayout>
