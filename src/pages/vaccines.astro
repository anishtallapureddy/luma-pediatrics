---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import { Icon } from 'astro-icon/components';

/**
 * Simplified childhood vaccine schedule (for parent reference only).
 * Source: AAP Recommended Childhood and Adolescent Immunization Schedule,
 * United States, 2026 (published Jan 26, 2026). The AAP now publishes this
 * schedule independently of the CDC/ACIP schedule.
 *
 * Ages below are the specific visit timings Luma Pediatrics uses, chosen
 * within the AAP's recommended ranges, and reviewed by the clinical team.
 * Dose numbers are intentionally omitted; catch-up and combination-product
 * timing vary by child, so the row is the visit rather than the dose count.
 *
 * Notable 2026 points reflected below:
 *   - Routine infant pneumococcal series is PCV15 or PCV20; Luma Pediatrics
 *     uses PCV15. PCV13 is no longer recommended for routine infant
 *     vaccination.
 *   - RSV immunisation (nirsevimab) is part of the routine schedule, but it
 *     is a seasonal monoclonal antibody, not a vaccine, and is not needed
 *     when the birthing parent had the RSV vaccine in pregnancy.
 *   - HPV may begin at age 9; AAP prefers starting earlier than 11-12.
 *   - Rotavirus is given by mouth, so it renders with a droplet icon and an
 *     "(oral)" label rather than the default syringe.
 *
 * Always confirm with your pediatrician - this is a quick parent overview.
 */
const schedule = [
  { age: 'Birth',           shots: ['Hepatitis B'] },
  { age: '1 month',         shots: ['Hepatitis B'] },
  { age: '2 months',        shots: ['DTaP', 'Hib', 'IPV (polio)', 'PCV15', 'Rotavirus (oral)'] },
  { age: '4 months',        shots: ['DTaP', 'Hib', 'IPV (polio)', 'PCV15', 'Rotavirus (oral)'] },
  { age: '6 months',        shots: ['DTaP', 'Hib', 'IPV (polio)', 'PCV15', 'Rotavirus (oral)'] },
  { age: '9 months',        shots: ['Hepatitis B'] },
  { age: '12 months',       shots: ['MMR', 'PCV15'] },
  { age: '15 months',       shots: ['Varicella (chickenpox)', 'Hepatitis A'] },
  { age: '18 months',       shots: ['Hib', 'DTaP'] },
  { age: '24 months',       shots: ['Hepatitis A'] },
  { age: '4–6 years',       shots: ['DTaP', 'IPV (polio)', 'MMR', 'Varicella'] },
  { age: '9–12 years',      shots: ['HPV (may start at age 9)'] },
  { age: '11–12 years',     shots: ['Tdap booster', 'Meningococcal (MenACWY)'] },
  { age: '16 years',        shots: ['Meningococcal booster', 'Meningococcal B (shared decision)'] },
  { age: 'RSV season',      shots: ['RSV antibody (nirsevimab)'] },
  { age: 'Annual (6 months+)', shots: ['Influenza (flu)'] },
  { age: '6–23 months',     shots: ['COVID-19 (routine)'] },
  { age: '2–18 years',      shots: ['COVID-19 (based on risk)'] },
];

/** Oral vaccines get a droplet icon instead of the default syringe. */
const isOral = (shot: string) => shot.includes('(oral)');

const lastReviewed = 'September 20, 2026';
---
<BaseLayout
  title="Childhood Vaccine Schedule | Luma Pediatrics McKinney"
  path="/vaccines"
  description="A parent-friendly overview of the AAP recommended childhood vaccine schedule, prepared by Luma Pediatrics in McKinney, TX."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: 'Vaccine Schedule', path: '/vaccines' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">Vaccines</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Childhood vaccine schedule
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Aligned with current AAP recommendations.
      </p>
      <p class="mt-7 text-base md:text-lg text-[var(--color-foreground)]/80 leading-relaxed">
        At Luma Pediatrics we follow the immunization schedule published by the
        American Academy of Pediatrics. We're happy to walk through it with you in detail,
        your questions are always welcome.
      </p>
    </div>
  </section>

  <section class="pb-16 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="sr-only">Recommended immunization schedule by age</h2>
      <div class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] overflow-hidden">
        <div class="grid grid-cols-[10rem_1fr] sm:grid-cols-[14rem_1fr] bg-[var(--color-muted)] text-[var(--color-primary)] text-xs font-bold uppercase tracking-[0.14em] p-4">
          <div>Age</div>
          <div>Recommended vaccines</div>
        </div>
        <ul class="divide-y divide-[var(--color-border-soft)]">
          {schedule.map(({ age, shots }) => (
            <li class="grid grid-cols-[10rem_1fr] sm:grid-cols-[14rem_1fr] gap-4 p-4 md:p-5">
              <div class="font-bold text-[var(--color-foreground)]">{age}</div>
              <ul class="flex flex-wrap gap-2">
                {shots.map((s) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-muted)] px-3 py-1 text-xs font-semibold text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.20)]">
                    <Icon name={isOral(s) ? 'lucide:droplet' : 'lucide:syringe'} class="w-3.5 h-3.5" stroke-width="2" aria-hidden="true" />
                    {s}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8 rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-5">
        <h2 class="font-display text-xl text-[var(--color-primary)]">A few notes on the newer recommendations</h2>
        <dl class="mt-4 space-y-4 text-sm leading-relaxed text-[var(--color-foreground)]/90">
          <div>
            <dt class="font-semibold text-[var(--color-foreground)]">RSV protection is seasonal, and it is an antibody rather than a vaccine.</dt>
            <dd class="mt-1 text-[var(--color-muted-foreground)]">
              Nirsevimab is given during RSV season (roughly fall through spring) to infants under
              8 months entering their first season. It is usually not needed when the birthing parent
              received the RSV vaccine during pregnancy. Some children aged 8–19 months with higher-risk
              conditions are also protected for a second season.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-foreground)]">We use PCV15 for pneumococcal protection.</dt>
            <dd class="mt-1 text-[var(--color-muted-foreground)]">
              PCV15 and PCV20 both replaced PCV13 for the routine infant series, and the AAP accepts
              either one. Luma Pediatrics uses PCV15. A child who started the series elsewhere on
              PCV13 or PCV20 does not need to start over.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-foreground)]">HPV vaccination can begin at age 9.</dt>
            <dd class="mt-1 text-[var(--color-muted-foreground)]">
              The AAP now prefers starting between ages 9 and 12 rather than waiting until 11–12.
              Starting before the 15th birthday means two doses instead of three.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-foreground)]">COVID-19 depends on your child's age and health.</dt>
            <dd class="mt-1 text-[var(--color-muted-foreground)]">
              The AAP recommends it routinely for children 6–23 months. For ages 2 and up, it is based
              on your child's risk factors and your family's preference. This is a good conversation
              to have with your child's healthcare provider.
            </dd>
          </div>
        </dl>
      </div>

      <p class="mt-4 text-xs text-[var(--color-muted-foreground)] leading-relaxed">
        Based on the AAP Recommended Childhood and Adolescent Immunization Schedule
        (United States, 2026). Last reviewed by the Luma Pediatrics clinical team:
        <strong>{lastReviewed}</strong>.
      </p>

      <div class="mt-8 rounded-xl bg-[rgba(231,108,112,0.10)] border border-[rgba(231,108,112,0.40)] p-4 flex items-start gap-3">
        <Icon name="lucide:info" class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-coral)]" stroke-width="1.8" aria-hidden="true" />
        <p class="text-sm text-[var(--color-foreground)]/90 leading-relaxed">
          <strong>This is a quick parent reference, not medical advice.</strong> Your child's
          actual schedule may differ based on their medical history, prior doses, or catch-up
          timing. Review the schedule with your child's current healthcare provider.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a
          href="/blog/vaccine-schedule-explained/"
          class="card-lift rounded-[var(--radius-card)] bg-[var(--color-sage-light)] p-5 ring-1 ring-[var(--color-border-soft)] no-underline sm:col-span-2"
        >
          <p class="text-sm font-semibold text-[var(--color-primary)]">A parent's guide to the vaccine schedule →</p>
          <p class="mt-1 text-sm text-[var(--color-foreground)] leading-relaxed">
            Want the longer story, what each vaccine protects against, why timing matters,
            and the questions parents ask us most? Read our full guide.
          </p>
        </a>
        <a
          href="https://www.healthychildren.org/English/safety-prevention/immunizations/Pages/Recommended-Immunization-Schedules.aspx"
          target="_blank"
          rel="noopener"
          class="card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 ring-1 ring-[var(--color-border-soft)] no-underline"
        >
          <p class="text-sm font-semibold text-[var(--color-foreground)]">AAP official schedule →</p>
          <p class="mt-1 text-sm text-[var(--color-foreground)]/70 leading-relaxed">
            The latest AAP immunization schedule for parents, on HealthyChildren.org.
          </p>
        </a>
        <a
          href="https://www.aap.org/en/patient-care/immunizations/"
          target="_blank"
          rel="noopener"
          class="card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 ring-1 ring-[var(--color-border-soft)] no-underline"
        >
          <p class="text-sm font-semibold text-[var(--color-foreground)]">AAP immunization resources →</p>
          <p class="mt-1 text-sm text-[var(--color-foreground)]/70 leading-relaxed">
            Parent-facing guidance from the American Academy of Pediatrics.
          </p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>