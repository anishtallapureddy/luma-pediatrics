---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import AfterHoursCard from '../components/AfterHoursCard.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';
import { insurancePlans, additionalInsurancePlans, insuranceCoverageNote } from '../data/insurance';
import { selfPayPricing, selfPayServices } from '../data/selfPay';
import { getMedicalScheduling, getMeetAndGreetScheduling } from '../utils/serviceScheduling';

const medicalScheduling = getMedicalScheduling(SITE);
const meetAndGreet = getMeetAndGreetScheduling(SITE.meetAndGreetScheduling);
const bookingOptions = medicalScheduling.appointments.enabled
  ? [medicalScheduling.appointments]
  : [medicalScheduling.newborn, medicalScheduling.wellChild].filter(({ enabled }) => enabled);

/**
 * First-visit walkthrough. Photos are intentionally omitted for now; the
 * `img`/`alt` fields are retained as scaffolding so real clinic photography can
 * be reintroduced later without rebuilding the steps.
 */
const steps = [
  {
    n: '1',
    t: medicalScheduling.enabled ? 'Schedule an available visit type' : 'Schedule when appointments open',
    d: medicalScheduling.appointments.enabled
      ? `Use Phreesia to choose a newborn, behavioral, sick, or well-child appointment from ${SITE.openingWindow} onward. Confirm your appointment date, insurance, and costs before booking. Call or text with general questions about other visit types.`
      : medicalScheduling.enabled
        ? 'Use the approved service links below to choose an available appointment. Clinical care begins on opening day; confirm your appointment date, insurance, and costs before booking.'
        : 'Scheduling is not available yet. We’ll share appointment details closer to opening.',
    img: '/images/journey-1.jpg',
    alt: 'A parent booking a pediatric visit online from a warm, sunlit home',
  },
  {
    n: '2',
    t: 'Prepare your records',
    d: "Photo ID, your insurance card, and your child's immunization records (if available). For newborns, bring discharge paperwork from the hospital.",
    img: '/images/journey-2.jpg',
    alt: 'A family preparing ID, insurance card, and immunization records for a first visit',
  },
  {
    n: '3',
    t: 'Meet your pediatrician',
    d: 'Your first visit includes time for an exam and your questions.',
    img: '/images/journey-3.jpg',
    alt: 'A pediatrician meeting a child and parent at eye level in a calm exam room',
  },
  {
    n: '4',
    t: 'Leave with a clear plan',
    d: 'We will explain the next steps and any follow-up your child needs.',
    img: '/images/journey-4.jpg',
    alt: 'A parent reviewing a visit summary and telehealth follow-up on their phone',
  },
];

const bringList = [
  'Photo ID for the parent or legal guardian',
  'Insurance card',
  'Immunization records, if available',
  'A list of any current medications',
  'For newborns: hospital discharge paperwork',
  'Forms that need to be signed (school, sports, camp)',
];
---
<BaseLayout
  title="New Patients | Luma Pediatrics in McKinney, TX"
  path="/new-patients"
  description={`Plan your child's first visit at ${SITE.name} in McKinney, TX. Review accepted insurance, self-pay pricing, and what to bring. ${SITE.status}.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'New Patients', path: '/new-patients' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="site-container relative z-10 text-center fade-up">
      <span class="eyebrow">New patients</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Your child’s first visit
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        First-visit details, accepted insurance, and self-pay pricing.
      </p>
      {medicalScheduling.appointments.enabled && (
        <div class="mt-6"><Button href={medicalScheduling.appointments.href}>{medicalScheduling.appointments.label}</Button></div>
      )}
      <div class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href="#what-to-bring" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">What to bring</a>
        <a href="#insurance" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Accepted insurance</a>
        <a href="#self-pay" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Self-pay pricing</a>
        <a href="#meet-and-greet" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Free Meet &amp; Greet</a>
      </div>
    </div>
  </section>

  <section id="first-visit" class="scroll-mt-32 pb-16 md:pb-20 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="site-container relative z-10">
      <p class="mb-6 text-[var(--color-foreground)]/80 leading-relaxed">
        {SITE.status}.{' '}
        {!medicalScheduling.enabled && <>Appointments are not available yet. Scheduling details will be shared closer to opening.{' '}</>}
        This guide describes visits after opening.{' '}
        <a href="/#practice-updates" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Opening updates</a>
        {' '}are optional and are not patient registration.
      </p>
      <ol class="space-y-5">
        {steps.map(({ n, t, d }) => (
          <li class="walkthrough-step card-lift flex gap-5 items-start rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-7">
            <span
              class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary)] text-white font-extrabold text-lg"
              style="font-family: var(--font-display); box-shadow: inset 0 1px 1px rgba(255,255,255,0.25);"
              aria-hidden="true"
            >{n}</span>
            <div class="min-w-0 flex-1">
              <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">{t}</h2>
              <p class="mt-3 text-[var(--color-foreground)]/82 leading-relaxed">{d}</p>
              {n === '1' && bookingOptions.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
                  {bookingOptions.map(({ href, label }) => <a href={href} class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4">{label}</a>)}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="meet-and-greet" aria-labelledby="meet-and-greet-heading" class="scroll-mt-32 pb-16 md:pb-20 reveal">
    <div class="site-container">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-muted)] ring-1 ring-inset ring-[var(--color-border-soft)] p-8 md:p-10">
        <span class="eyebrow">Free Meet &amp; Greet</span>
        <h2 id="meet-and-greet-heading" class="mt-5 text-3xl md:text-4xl tracking-tight">
          {SITE.showProviderProfile ? 'Meet Dr. T' : 'Meet our pediatrician'}
        </h2>
        <p class="mt-5 text-lg text-[var(--color-foreground)]/85 leading-relaxed">
          Choosing a pediatrician is an important decision, and we'd love the opportunity to get to know your family!
        </p>
        <p class="mt-4 text-[var(--color-foreground)]/85 leading-relaxed">
          Schedule a complimentary Meet &amp; Greet to visit our clinic, meet {SITE.showProviderProfile ? SITE.provider.shortName : 'our pediatrician'}, ask questions, and see if Luma Pediatrics is the right fit for your family.
        </p>
        <p class="mt-4 text-[var(--color-foreground)]/85 leading-relaxed">
          These visits are free, with no obligation to establish care.
        </p>
        <p class="mt-4 text-sm text-[var(--color-foreground)]/80 leading-relaxed">
          <strong>Please note:</strong> Meet &amp; Greet visits are introductory only and do not include a medical evaluation or treatment.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href={meetAndGreet.href}>{meetAndGreet.label}</Button>
          <a href="/meet-and-greet/" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">What to expect at a Meet &amp; Greet</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-12">
    <div class="site-container">
      <h2 class="text-2xl md:text-3xl">Expecting a baby?</h2>
      <p class="mt-4 leading-relaxed">Choosing a pediatrician can help you prepare for your baby's arrival. <a href="/newborn-care/" class="font-semibold underline underline-offset-4">Explore Newborn Care</a> and learn what to expect during the first visits.</p>
      <p class="mt-4 leading-relaxed">For routine preventive care, <a href="/well-child-visits/" class="font-semibold underline underline-offset-4">explore our Well-Child Visits</a>.</p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-[var(--color-muted)] reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="site-container relative z-10">
      <div id="what-to-bring" class="scroll-mt-32">
        <span class="eyebrow">What to bring</span>
        <h2 class="mt-5 text-2xl md:text-3xl font-extrabold tracking-tight">A quick checklist</h2>
        <ul class="mt-6 space-y-2.5">
          {bringList.map((item) => (
            <li class="flex gap-3 text-[var(--color-foreground)]/85">
              <Icon name="lucide:check-circle" class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-sage-light)]" stroke-width="1.8" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-[var(--color-foreground)]/80 leading-relaxed">
          Expecting a baby?{' '}
          <a href="/blog/newborn-first-week/" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Read our guide to the first week at home.</a>
        </p>
      </div>
    </div>
  </section>

  <section id="insurance" aria-labelledby="insurance-heading" class="scroll-mt-32 py-16 md:py-20 reveal">
    <div class="site-container">
      <h2 id="insurance-heading" class="text-3xl md:text-4xl tracking-tight">Major Insurance Plans Accepted</h2>
      <p class="mt-3 text-sm md:text-base font-semibold text-[var(--color-primary)]">
        No membership fee.
      </p>
      <ul role="list" class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-8 rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-8">
        {insurancePlans.map(({ name, logo, width, height }) => (
          <li class="flex h-20 w-60 max-w-full items-center justify-center">
            <img src={logo} width={width} height={height} alt={name} loading="lazy" decoding="async" class="max-w-full max-h-16 h-auto object-contain" />
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <h2 class="text-2xl md:text-3xl tracking-tight">Other accepted plans and networks</h2>
        <ul role="list" class="mt-5 grid gap-x-12 gap-y-3 sm:grid-cols-2 list-disc pl-5 text-[var(--color-foreground)]/85 leading-relaxed">
          {additionalInsurancePlans.map((name) => <li>{name}</li>)}
        </ul>

        <p class="mt-6 text-[var(--color-foreground)]/85 leading-relaxed">
          {insuranceCoverageNote}{' '}
          <a href={SITE.contact.phoneHref} class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Call</a>{' or '}
          <a href={SITE.contact.smsHref} class="font-semibold text-[var(--color-primary)] underline underline-offset-4">text</a>{' '}
          {SITE.contact.phone}{' '}
          to verify coverage before your visit.
        </p>
        <p class="mt-3 text-sm text-[var(--color-foreground)]/80 leading-relaxed">{SITE.contact.textingNote}</p>
      </div>
    </div>
  </section>

  <section id="self-pay" aria-labelledby="self-pay-heading" class="scroll-mt-44 md:scroll-mt-32 pb-16 md:pb-20 reveal">
    <div class="site-container">
      <h2 id="self-pay-heading" class="text-3xl md:text-4xl tracking-tight">Self-pay pricing</h2>
      <p class="mt-5 text-[var(--color-foreground)]/85 leading-relaxed">
        For families paying without insurance. These fees apply to visits after our practice opens.
      </p>
      <ul role="list" class="mt-8 grid gap-4 sm:grid-cols-2">
        {selfPayServices.map(({ name, price, detail }) => (
          <li class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-7">
            <div class="flex items-start justify-between gap-4">
              <h3 class="min-w-0 text-xl md:text-2xl tracking-tight">
                {name.split(/ (?=\()/).map((line, index) => (
                  <span class={index === 0 ? 'block' : 'block mt-1 text-base md:text-lg leading-snug'}>{index > 0 ? ' ' : ''}{line}</span>
                ))}
              </h3>
              <p class="shrink-0 text-3xl font-semibold text-[var(--color-primary)]">{price}</p>
            </div>
            <p class="mt-3 text-sm text-[var(--color-foreground)]/80 leading-relaxed">{detail}</p>
          </li>
        ))}
      </ul>
      <div class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-muted)] p-6 md:p-7">
        <h3 class="text-xl md:text-2xl tracking-tight">Visit fees and additional costs</h3>
        <p class="mt-3 text-[var(--color-foreground)]/85 leading-relaxed">
          {selfPayPricing.visitFeeNote}{' '}{selfPayPricing.additionalCharges}
        </p>
        <p class="mt-3 text-[var(--color-foreground)]/85 leading-relaxed">
          <a href={SITE.contact.phoneHref} class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Call</a>{' or '}
          <a href={SITE.contact.smsHref} class="font-semibold text-[var(--color-primary)] underline underline-offset-4">text</a>{' '}
          {SITE.contact.phone}{' '}
          for an estimate before your visit.
        </p>
        <p class="mt-3 text-sm text-[var(--color-foreground)]/80 leading-relaxed">{SITE.contact.textingNote}</p>
      </div>
    </div>
  </section>

  <section class="pt-12 pb-16 reveal">
    <div class="site-container">
      <AfterHoursCard />
    </div>
  </section>

</BaseLayout>
