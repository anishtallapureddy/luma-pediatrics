---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import AfterHoursCard from '../components/AfterHoursCard.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';
import { insurancePlans, additionalInsurancePlans, insuranceCoverageNote } from '../data/insurance';
import { getMedicalScheduling } from '../utils/serviceScheduling';

const medicalScheduling = getMedicalScheduling(SITE);
const bookingOptions = [medicalScheduling.newborn, medicalScheduling.wellChild].filter(({ enabled }) => enabled);
const dateFormat = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;
const openingTarget = new Date(SITE.openingTargetDate).toLocaleDateString('en-US', dateFormat);
const bookingTargets = [...new Set([SITE.newbornScheduling.plannedLaunchDate, SITE.wellChildScheduling.plannedLaunchDate])]
  .map((date) => new Date(date).toLocaleDateString('en-US', dateFormat)).join(' and ');

/**
 * First-visit walkthrough. Photos are intentionally omitted for now; the
 * `img`/`alt` fields are retained as scaffolding so real clinic photography can
 * be reintroduced later without rebuilding the steps.
 */
const steps = [
  {
    n: '1',
    t: medicalScheduling.enabled ? 'Schedule an available visit type' : 'Schedule when appointments open',
    d: medicalScheduling.enabled
      ? 'Online booking is available for the visit types linked below. The practice is not open yet; confirm appointment dates, insurance, and costs before booking.'
      : 'Scheduling is not available yet. We’ll share appointment details closer to opening.',
    img: '/images/journey-1.jpg',
    alt: 'A parent booking a pediatric visit online from a warm, sunlit home',
  },
  {
    n: '2',
    t: 'Prepare your records',
    d: "Photo ID, your insurance card, and your child's immunization records (if available). For newborns, bring discharge paperwork from the hospital.",
    img: '/images/journey-2.jpg',
    alt: 'A family preparing ID, insurance card, and immunization records for a first visit',
  },
  {
    n: '3',
    t: 'Meet your pediatrician',
    d: 'First visits are planned to allow time for an exam and your questions.',
    img: '/images/journey-3.jpg',
    alt: 'A pediatrician meeting a child and parent at eye level in a calm exam room',
  },
  {
    n: '4',
    t: 'Leave with a clear plan',
    d: 'We plan to explain the next steps and any follow-up your child needs.',
    img: '/images/journey-4.jpg',
    alt: 'A parent reviewing a visit summary and telehealth follow-up on their phone',
  },
];

const bringList = [
  'Photo ID for the parent or legal guardian',
  'Insurance card',
  'Immunization records, if available',
  'A list of any current medications',
  'For newborns: hospital discharge paperwork',
  'Forms that need to be signed (school, sports, camp)',
];
---
<BaseLayout
  title="New Patients | Luma Pediatrics in McKinney, TX"
  path="/new-patients"
  description={`Plan your child's first visit at ${SITE.name} in McKinney, TX. Review accepted commercial insurance plans, coverage verification, and what to bring. ${SITE.status}.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'New Patients', path: '/new-patients' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">New patients</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Planning your child’s first visit
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        What to bring, what to expect, and accepted insurance plans.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href="#what-to-bring" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">What to bring</a>
        <a href="#insurance" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Accepted insurance</a>
      </div>
    </div>
  </section>

  <section id="first-visit" class="scroll-mt-32 pb-16 md:pb-20 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <p class="max-w-3xl mx-auto mb-6 text-[var(--color-foreground)]/80 leading-relaxed">
        Our target opening is {openingTarget}, subject to readiness.
        {!medicalScheduling.enabled && <> Online medical booking is targeted for {bookingTargets}, but appointments are not available yet.</>}
        This guide describes visits after opening.
        <a href="/#practice-updates" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Opening updates</a>
        are optional and are not patient registration.
      </p>
      <ol class="max-w-3xl mx-auto space-y-5">
        {steps.map(({ n, t, d }) => (
          <li class="walkthrough-step card-lift flex gap-5 items-start rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-7">
            <span
              class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-primary)] text-white font-extrabold text-lg"
              style="font-family: var(--font-display); box-shadow: inset 0 1px 1px rgba(255,255,255,0.25);"
              aria-hidden="true"
            >{n}</span>
            <div class="min-w-0 flex-1">
              <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">{t}</h2>
              <p class="mt-3 text-[var(--color-foreground)]/82 leading-relaxed">{d}</p>
              {n === '1' && bookingOptions.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
                  {bookingOptions.map(({ href, label }) => <a href={href} class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4">{label}</a>)}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pb-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl">Expecting a baby?</h2>
      <p class="mt-4 leading-relaxed">Choosing a pediatrician can help you prepare for your baby's arrival. <a href="/newborn-care/" class="font-semibold underline underline-offset-4">Explore Newborn Care</a> and learn what to expect during the first visits.</p>
      <p class="mt-4 leading-relaxed">Want to get to know our pediatrician first? <a href="/meet-and-greet/" class="font-semibold underline underline-offset-4">Learn about our Free Meet &amp; Greet</a>, planned after opening.</p>
      <p class="mt-4 leading-relaxed">For routine preventive care, <a href="/well-child-visits/" class="font-semibold underline underline-offset-4">explore our Well-Child Visits</a>.</p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-[var(--color-muted)] reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div id="what-to-bring" class="scroll-mt-32">
        <span class="eyebrow">What to bring</span>
        <h2 class="mt-5 text-2xl md:text-3xl font-extrabold tracking-tight">A quick checklist</h2>
        <ul class="mt-6 space-y-2.5">
          {bringList.map((item) => (
            <li class="flex gap-3 text-[var(--color-foreground)]/85">
              <Icon name="lucide:check-circle" class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-sage-light)]" stroke-width="1.8" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-[var(--color-foreground)]/80 leading-relaxed">
          Expecting a baby?
          <a href="/blog/newborn-first-week/" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Read our guide to the first week at home.</a>
        </p>
      </div>
    </div>
  </section>

  <section id="insurance" aria-labelledby="insurance-heading" class="scroll-mt-32 py-16 md:py-20 reveal">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="insurance-heading" class="text-3xl md:text-4xl tracking-tight">Major Insurance Plans Accepted</h2>
      <ul role="list" class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-8 rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-8">
        {insurancePlans.map(({ name, logo, width, height }) => (
          <li class="flex h-20 w-60 max-w-full items-center justify-center">
            <img src={logo} width={width} height={height} alt={name} loading="lazy" decoding="async" class="max-w-full max-h-16 h-auto object-contain" />
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <h2 class="text-2xl md:text-3xl tracking-tight">Other accepted plans and networks</h2>
        <ul role="list" class="mt-5 grid gap-x-12 gap-y-3 sm:grid-cols-2 list-disc pl-5 text-[var(--color-foreground)]/85 leading-relaxed">
          {additionalInsurancePlans.map((name) => <li>{name}</li>)}
        </ul>

        <p class="mt-6 text-[var(--color-foreground)]/85 leading-relaxed">
          {insuranceCoverageNote} Call{' '}
          <a href={`tel:${SITE.contact.phoneE164}`} class="font-semibold text-[var(--color-primary)] underline underline-offset-4">{SITE.contact.phone}</a>{' '}
          to verify coverage before your visit.
        </p>
      </div>
    </div>
  </section>

  <section class="pt-12 pb-16 reveal">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <AfterHoursCard />
    </div>
  </section>

</BaseLayout>
