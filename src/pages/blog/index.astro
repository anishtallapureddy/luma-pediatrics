---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageDecor from '../../components/PageDecor.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const description =
  'Pediatric information and parent guides from Luma Pediatrics in McKinney, Texas.';
const intro = 'Start with our published guides below.';
---
<BaseLayout
  title="Blog & Parent Guides"
  description={description}
  path="/blog/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources/' },
    { name: 'Blog & Parent Guides', path: '/blog/' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="site-container relative z-10 text-center fade-up">
      <span class="eyebrow">Blog &amp; Parent Guides</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Practical pediatric information
      </h1>
      <p class="mt-6 mx-auto text-lg text-[var(--color-muted-foreground)] leading-relaxed">
        {intro}
      </p>
    </div>
  </section>

  <section class="site-container pb-24">
    {posts.length === 0 ? (
      <p class="text-[var(--color-muted-foreground)]">Posts coming soon.</p>
    ) : (
      <ul class:list={[
        'grid gap-8',
        posts.length > 1 ? 'sm:grid-cols-2' : 'max-w-xl mx-auto',
        posts.length > 2 && 'lg:grid-cols-3',
      ]}>
        {posts.map((post) => <BlogCard post={post} />)}
      </ul>
    )}

    <p class="mt-8 text-center text-sm">
      <a href="/rss.xml" class="text-[var(--color-primary)] underline underline-offset-4">RSS feed</a>
    </p>

    <p class="mt-12 text-xs text-[var(--color-muted-foreground)] text-center mx-auto leading-relaxed">
      Articles on this site are for general educational purposes only and are
      not a substitute for personalized advice from your child's pediatrician.
      For urgent concerns, contact your child's current healthcare provider or go to the nearest emergency room.
    </p>
  </section>
</BaseLayout>
