---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageDecor from '../../components/PageDecor.astro';
import Picture from '../../components/Picture.astro';
import { Icon } from 'astro-icon/components';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const description =
  'Physician-reviewed pediatric information and parent guides from Luma Pediatrics in McKinney, Texas.';
const intro = posts.length === 1
  ? 'Start with our current physician-reviewed guide. Additional articles on fevers, sleep, newborn care, and common parent questions are in development.'
  : 'Articles on fevers, sleep, newborn care, vaccines, and when to contact a healthcare provider.';
---
<BaseLayout
  title="Blog & Parent Guides"
  description={description}
  path="/blog/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Blog & Parent Guides', path: '/blog/' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">Blog &amp; Parent Guides</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Practical pediatric information
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-[var(--color-muted-foreground)] leading-relaxed">
        {intro}
      </p>
      <a
        href="/rss.xml"
        class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] no-underline hover:underline"
      >
        Subscribe to the RSS feed
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    {posts.length === 0 ? (
      <p class="text-[var(--color-muted-foreground)]">Posts coming soon.</p>
    ) : (
      <ul class:list={[
        'grid gap-8',
        posts.length > 1 ? 'sm:grid-cols-2' : 'max-w-xl mx-auto',
      ]}>
        {posts.map((post) => {
          const date = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
          });
          return (
            <li class="blog-card reveal">
              <a href={`/blog/${post.id}/`} class="block no-underline">
                {post.data.hero && (
                  <figure class="blog-card-figure">
                    <Picture
                      src={post.data.hero}
                      alt={post.data.heroAlt ?? post.data.title}
                      width={1200}
                      height={900}
                      loading="lazy"
                    />
                  </figure>
                )}
                <div class="p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">
                    {date}
                  </p>
                  <h2 class="mt-2 font-display text-2xl text-[var(--color-primary)] leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-[var(--color-muted-foreground)] leading-relaxed">
                    {post.data.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)]">
                    Read article
                    <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p class="mt-12 text-xs text-[var(--color-muted-foreground)] text-center max-w-2xl mx-auto leading-relaxed">
      Articles on this site are for general educational purposes only and are
      not a substitute for personalized advice from your child's pediatrician.
      For urgent concerns, contact your child's current healthcare provider or go to the nearest emergency room.
    </p>
  </section>
</BaseLayout>

<style>
  .blog-card {
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-border-soft);
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--duration-base) var(--ease-fluid),
      box-shadow var(--duration-base) var(--ease-fluid);
  }
  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft-hover);
  }
  .blog-card-figure {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin: 0;
  }
  .blog-card-figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-emphasized) var(--ease-fluid);
  }
  .blog-card:hover .blog-card-figure :global(img) {
    transform: scale(1.04);
  }
</style>
