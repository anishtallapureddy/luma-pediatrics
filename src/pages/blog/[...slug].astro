---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, STRUCTURED_DATA_IDS } from '../../site.config';
import './article.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const updatedLabel = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const updated = updatedLabel === date ? undefined : updatedLabel;
const articleUrl = `${SITE.domain}/blog/${post.id}/`;
const articleImage = post.data.hero ? `${SITE.domain}${post.data.hero}` : `${SITE.domain}${SITE.socialImage}`;
const articleImages = post.data.hero
  ? [
      {
        '@type': 'ImageObject',
        url: articleImage,
        width: 1200,
        height: 900,
      },
      ...(post.data.heroWide
        ? [{
            '@type': 'ImageObject',
            url: `${SITE.domain}${post.data.heroWide}`,
            width: 1200,
            height: 675,
          }]
        : []),
      ...(post.data.heroSquare
        ? [{
            '@type': 'ImageObject',
            url: `${SITE.domain}${post.data.heroSquare}`,
            width: 900,
            height: 900,
          }]
        : []),
    ]
  : [{
      '@type': 'ImageObject',
      url: articleImage,
      width: 1200,
      height: 630,
    }];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: SITE.showProviderProfile
    ? {
        '@type': 'Person',
        '@id': STRUCTURED_DATA_IDS.physician,
        name: SITE.provider.schemaName,
        url: `${SITE.domain}/about/`,
      }
    : {
        '@type': 'Organization',
        '@id': STRUCTURED_DATA_IDS.clinic,
        name: SITE.name,
      },
  publisher: { '@id': STRUCTURED_DATA_IDS.clinic },
  image: articleImages,
  mainEntityOfPage: { '@id': `${articleUrl}#webpage` },
  articleSection: 'Pediatric health',
  inLanguage: 'en-US',
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  ogImage={post.data.hero}
  ogImageAlt={post.data.heroAlt ?? post.data.title}
  ogImageWidth={1200}
  ogImageHeight={post.data.hero ? 900 : 630}
  ogType="article"
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources/' },
    { name: 'Parent Guides', path: '/blog/' },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="blog-article">
    <header class="blog-article__header">
      <p class="blog-article__back">
        <a href="/blog/" class="no-underline hover:underline">← Blog &amp; Parent Guides</a>
      </p>

      <h1 class="blog-article__title">
        {post.data.title}
      </h1>

      <div class="blog-article__meta">
        <p class="blog-article__author">
          By
          {' '}<a href="/about/" rel="author" class="text-inherit underline-offset-4 hover:underline">
            {post.data.author}
          </a>
        </p>
        <p class="blog-article__meta-details">
          <span>{post.data.authorTitle}</span>
          <span class="blog-article__separator" aria-hidden="true">·</span>
          <time datetime={post.data.publishDate.toISOString()}>{date}</time>
          {updated && (<><span class="blog-article__separator" aria-hidden="true">·</span><span>Updated {updated}</span></>)}
        </p>
      </div>
    </header>

    {post.data.hero && (
      <figure class="blog-article__hero">
        <img
          src={post.data.heroWide ?? post.data.hero}
          alt={post.data.heroAlt ?? post.data.title}
          width={1200}
          height={post.data.heroWide ? 675 : 900}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="prose-luma blog-article__body">
      <Content />
    </div>

    <aside class="blog-article__resources">
      <p class="font-display text-2xl text-[var(--color-primary)]">
        More parent resources
      </p>
      {post.id === 'vaccine-schedule-explained' && (
        <p class="mt-5 text-sm">
          <a href="/vaccines/" class="inline-flex min-h-11 items-center font-semibold">
            See the vaccine schedule at a glance →
          </a>
        </p>
      )}
      {post.id === 'newborn-first-week' && (
        <p class="mt-5 text-sm">
          <a href="/newborn-care/" class="inline-flex min-h-11 items-center font-semibold">
            Explore Luma’s planned newborn care →
          </a>
        </p>
      )}
      <p class="mt-3 text-sm">
        <a href="/resources/" class="inline-flex min-h-11 items-center font-semibold">Browse all parent resources →</a>
      </p>
      <p class="mt-5 text-sm text-[var(--color-primary)] leading-relaxed">
        {SITE.status}.
        <a href="/contact/" class="underline underline-offset-4">General questions about Luma? Call or text us.</a>
      </p>
    </aside>

    <p class="blog-article__disclaimer">
      This article is for general educational purposes only and is not a
      substitute for personalized advice from your child's pediatrician.
      For urgent concerns, contact your child's current healthcare provider or go to the nearest emergency room.
    </p>
  </article>
</BaseLayout>
