---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../data/services';
---
<BaseLayout
  title="Pediatric Services in McKinney, TX | Luma Pediatrics"
  path="/services"
  description="Explore Luma Pediatrics' planned McKinney services: newborn care, well visits, sick care, vaccines, physicals, ADHD support, and teen health."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">Services</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        What does your child need?
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Checkups, sick visits, and care as your child grows.
      </p>
      <details class="group mt-6">
        <summary class="mx-auto flex min-h-11 w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-[var(--color-border-soft)] px-5 text-sm font-semibold text-[var(--color-primary)] [&::-webkit-details-marker]:hidden">
          Find care or visit information
          <Icon name="lucide:chevron-down" class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <nav aria-label="Find pediatric care" class="mt-5 text-left">
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-5 gap-y-2 text-sm">
            {services.map(({ slug, title }) => (
              <li>
                <a href={`#${slug}`} class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">{title}</a>
              </li>
            ))}
            <li><a href="/contact/#planned-hours" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Saturday hours</a></li>
            <li><a href="/faq/#after-hours" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">After-hours guidance</a></li>
            <li><a href="/new-patients/#insurance" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Insurance &amp; first visits</a></li>
            <li><a href="/new-patients/#self-pay" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Self-pay pricing</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </section>

  <section class="pb-20 md:pb-28 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid gap-5">
        {services.map(({ slug, icon, title, full, badge, nextStep }) => (
          <article
            id={slug}
            class="card-lift scroll-mt-32 rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 sm:p-7 flex gap-3 sm:gap-5"
          >
            <span
              class="shrink-0 inline-flex items-center justify-center w-10 h-10 sm:w-14 sm:h-14 rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(11,29,58,0.08)]"
              style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
            >
              <Icon name={icon} class="w-5 h-5 sm:w-7 sm:h-7" stroke-width="1.6" aria-hidden="true" />
            </span>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-xl md:text-2xl font-bold">{title}</h2>
                {badge && <span class="service-badge">{badge}</span>}
              </div>
              <p class="mt-2 text-[var(--color-foreground)]/80 leading-relaxed">{full}</p>
              <a href={nextStep.href} class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--color-primary)] underline underline-offset-4">
                {nextStep.label}
                <Icon name="lucide:arrow-right" class="w-4 h-4 shrink-0" aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-12 text-center">
        <h2 class="text-2xl md:text-3xl">Considering Luma for your family?</h2>
        <p class="mt-3 mb-6 text-[var(--color-muted-foreground)]">Get opening news and updates about our planned care.</p>
        <Button href="/#practice-updates">Get opening updates</Button>
      </div>
    </div>
  </section>
</BaseLayout>
