---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import Button from '../components/Button.astro';
import ScenarioPhoto from '../components/ScenarioPhoto.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../data/services';
import { SITE } from '../site.config';
import { getMedicalScheduling } from '../utils/serviceScheduling';
const { appointments } = getMedicalScheduling(SITE);
---
<BaseLayout
  title="Pediatric Services in McKinney, TX | Luma Pediatrics"
  path="/services"
  description={`Explore Luma Pediatrics' McKinney services: newborn care, well visits, sick care, vaccines, physicals, ADHD support, and teen health. ${SITE.status}.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="site-container relative z-10 text-center fade-up">
      <span class="eyebrow">Services</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        What does your child need?
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Checkups, sick visits, and care as your child grows.
      </p>
      {appointments.enabled && (
        <div class="mt-6">
          <Button href={appointments.href}>{appointments.label}</Button>
          <p class="mt-4 text-sm text-[var(--color-muted-foreground)]">Online booking is available for newborn, behavioral, sick, and well-child visits. For other services, call or text us.</p>
        </div>
      )}
      <details class="group mt-6">
        <summary class="mx-auto flex min-h-11 w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-[var(--color-border-soft)] px-5 text-sm font-semibold text-[var(--color-primary)] [&::-webkit-details-marker]:hidden">
          Find care or visit information
          <Icon name="lucide:chevron-down" class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <nav aria-label="Find pediatric care" class="mt-5 text-left">
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-5 gap-y-2 text-sm">
            {services.map(({ slug, title }) => (
              <li>
                <a href={`#${slug}`} class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">{title}</a>
              </li>
            ))}
            <li><a href="/contact/#planned-hours" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Saturday hours</a></li>
            <li><a href="/after-hours/" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">After-hours guidance</a></li>
            <li><a href="/faq/#same-day-visits" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Same-day availability</a></li>
            <li><a href="/faq/#telehealth" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Telehealth eligibility</a></li>
            <li><a href="/new-patients/#first-visit" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">First visits</a></li>
            <li><a href="/new-patients/#what-to-bring" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">What to bring</a></li>
            <li><a href="/new-patients/#insurance" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Accepted insurance</a></li>
            <li><a href="/new-patients/#self-pay" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">Self-pay pricing</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </section>

  <section class="pb-20 md:pb-28 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="site-container relative z-10">
      <div class="grid gap-5">
        {services.map(({ slug, icon, title, full, badge, nextStep, photo, relatedCare }) => (
          <article
            id={slug}
            class:list={[
              'card-lift scroll-mt-32 rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 sm:p-7',
              photo && 'service-overview-card--photo',
            ]}
          >
            <div class="flex gap-3 sm:gap-5">
              <span
                class="shrink-0 inline-flex items-center justify-center w-10 h-10 sm:w-14 sm:h-14 rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(11,29,58,0.08)]"
                style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
              >
                <Icon name={icon} class="w-5 h-5 sm:w-7 sm:h-7" stroke-width="1.6" aria-hidden="true" />
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-xl md:text-2xl font-bold">{title}</h2>
                  {badge && <span class="service-badge">{badge}</span>}
                </div>
                <p class="mt-2 text-[var(--color-foreground)]/80 leading-relaxed">{full}</p>
                <a href={nextStep.href} class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--color-primary)] underline underline-offset-4">
                  {nextStep.label}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 shrink-0" aria-hidden="true" />
                </a>
                {relatedCare && (
                  <div id={relatedCare.slug} class="mt-5 scroll-mt-32 border-t border-[var(--color-border-soft)] pt-4">
                    <h3 class="text-lg font-semibold">{relatedCare.title}</h3>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/80 leading-relaxed">{relatedCare.full}</p>
                    <a href={relatedCare.nextStep.href} class="mt-3 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">
                      {relatedCare.nextStep.label}
                    </a>
                  </div>
                )}
              </div>
            </div>
            {photo && <ScenarioPhoto src={photo.src} alt={photo.alt} />}
          </article>
        ))}
      </div>
      <p id="free-meet-and-greet" class="mt-10 scroll-mt-32 text-center text-[var(--color-foreground)]/80 leading-relaxed">
        Still choosing a pediatrician?{' '}
        <a href="/new-patients/#meet-and-greet" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Schedule a free Meet &amp; Greet</a>{' '}
        from our New Patients page.
      </p>
      <div class="mt-12 text-center">
        <h2 class="text-2xl md:text-3xl">Ready to plan a visit?</h2>
        <p class="mt-3 mb-6 text-[var(--color-muted-foreground)]">Review accepted insurance and self-pay pricing, then choose an appointment for after we open.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={appointments.href}>{appointments.label}</Button>
          <Button href="/new-patients/" variant="secondary">First-visit guide</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-overview-card--photo {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .service-overview-card--photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: 2rem;
    }
  }
</style>
