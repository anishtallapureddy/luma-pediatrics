---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../data/services';
import { SITE } from '../site.config';
import { getMedicalScheduling } from '../utils/serviceScheduling';
const { appointments } = getMedicalScheduling(SITE);
---
<BaseLayout
  title="Pediatric Services in McKinney, TX | Luma Pediatrics"
  path="/services"
  description={`Explore Luma Pediatrics' McKinney services: newborn care, well visits, sick care, vaccines, physicals, ADHD support, and teen health. ${SITE.status}.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="site-container relative z-10 text-center fade-up">
      <span class="eyebrow">Services</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        What does your child need?
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Checkups, sick visits, and care as your child grows.
      </p>
      {appointments.enabled && (
        <div class="mt-6">
          <Button href={appointments.href}>{appointments.label}</Button>
          <p class="mt-4 text-sm text-[var(--color-muted-foreground)]">Online booking is available for newborn, behavioral, sick, and well-child visits. For other services, call or text us.</p>
        </div>
      )}
    </div>
  </section>

  <section class="pb-20 md:pb-28 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="site-container relative z-10">
      <div class="grid gap-5">
        {services.map(({ slug, icon, title, full, badge, nextStep, relatedCare }) => (
          <article
            id={slug}
            class="card-lift scroll-mt-32 rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 sm:p-7"
          >
            <div class="flex gap-3 sm:gap-5">
              <span
                class="shrink-0 inline-flex items-center justify-center w-10 h-10 sm:w-14 sm:h-14 rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(11,29,58,0.08)]"
                style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
              >
                <Icon name={icon} class="w-5 h-5 sm:w-7 sm:h-7" stroke-width="1.6" aria-hidden="true" />
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-xl md:text-2xl font-bold">{title}</h2>
                  {badge && <span class="service-badge">{badge}</span>}
                </div>
                <p class="mt-2 text-[var(--color-foreground)]/80 leading-relaxed">{full}</p>
                <a href={nextStep.href} class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--color-primary)] underline underline-offset-4">
                  {nextStep.label}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 shrink-0" aria-hidden="true" />
                </a>
                {relatedCare && (
                  <div id={relatedCare.slug} class="mt-5 scroll-mt-32 border-t border-[var(--color-border-soft)] pt-4">
                    <h3 class="text-lg font-semibold">{relatedCare.title}</h3>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/80 leading-relaxed">{relatedCare.full}</p>
                    <a href={relatedCare.nextStep.href} class="mt-3 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">
                      {relatedCare.nextStep.label}
                    </a>
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p id="free-meet-and-greet" class="mt-10 scroll-mt-32 text-center text-[var(--color-foreground)]/80 leading-relaxed">
        Still choosing a pediatrician?{' '}
        <a href="/new-patients/#meet-and-greet" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Schedule a free Meet &amp; Greet</a>{' '}
        from our New Patients page.
      </p>
      <div class="mt-12 text-center">
        <h2 class="text-2xl md:text-3xl">Ready to plan a visit?</h2>
        <p class="mt-3 mb-6 text-[var(--color-muted-foreground)]">Review <a href="/new-patients/#insurance" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">accepted insurance</a> and <a href="/new-patients/#self-pay" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">self-pay pricing</a>, then book your visit online. <a href="/contact/#office-hours" class="font-semibold text-[var(--color-primary)] underline underline-offset-4">Office hours</a> include Saturdays.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={appointments.href}>{appointments.label}</Button>
          <Button href="/new-patients/" variant="secondary">First-visit guide</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
