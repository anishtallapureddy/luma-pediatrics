---
/**
 * TEMPORARY pre-opening 404. Neutral: no marketing quick-links or CTAs.
 * The full-site 404 is in Git history (tag preopening-full-site).
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
---

<HoldingLayout
  title="Page not found | Luma Pediatrics"
  description="The page you're looking for isn't available."
  path="/404"
>
  <div class="nf">
    <h1 class="nf__title">Page not found</h1>
    <p class="nf__body">
      The page you&rsquo;re looking for isn&rsquo;t available. Luma Pediatrics is a future
      pediatric practice, and additional information will be published closer to opening.
    </p>
    <p class="nf__home">
      <a href="/">Return to the homepage</a>
    </p>
  </div>

  <style>
    .nf {
      text-align: center;
    }
    .nf__title {
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1;
    }
    .nf__body {
      margin: 1.25rem auto 0;
      max-width: 34rem;
      color: rgba(11, 29, 58, 0.85);
      line-height: 1.7;
    }
    .nf__home {
      margin-top: 1.75rem;
    }
    .nf__home a {
      color: var(--color-primary);
      font-weight: 600;
    }
  </style>
</HoldingLayout>
