---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import AfterHoursCard from '../components/AfterHoursCard.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';

const faqs = [
  {
    q: 'What ages will you see?',
    a: 'We plan to care for newborns through young adults, typically up to age 21, after the practice opens.',
  },
  {
    q: 'Which insurance plans will you accept?',
    a: 'Insurance credentialing is in progress. The confirmed list will be published before scheduling opens.',
  },
  {
    q: 'Do you offer same-day sick visits?',
    a: 'After opening, we plan to offer same-day sick visits whenever capacity allows. Scheduling details will be published before appointments open.',
  },
  {
    q: 'Do you offer telehealth / virtual visits?',
    a: 'After opening, we plan to offer secure telehealth follow-ups for appropriate established-patient needs when an in-person exam is not required.',
  },
  {
    q: 'How do I book an appointment?',
    a: "We're opening in late 2026 in McKinney and are not scheduling appointments yet. Join the independent email updates list for general opening news.",
  },
  {
    q: 'What should I bring to a first visit?',
    a: 'Bring a photo ID, your insurance card, your child\'s immunization records (if available), and any forms that need to be signed. For newborns, bring the discharge paperwork from the hospital.',
  },
  {
    q: 'Do you do school, sports, and camp physicals?',
    a: 'After opening, we plan to offer school, sports, and camp physicals as part of appropriate well-child care.',
  },
  {
    q: 'When are you opening?',
    a: `We're opening ${SITE.openingWindow} in ${SITE.locationShort}. Join the email updates list for general opening news.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout
  title="FAQ | Luma Pediatrics McKinney"
  path="/faq"
  description="Common questions about Luma Pediatrics in McKinney, TX: insurance, planned same-day visits, first appointments, ages we see, and our November 2026 opening."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="page-hero py-14 md:py-20 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">FAQ</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Common questions
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        About the future practice
      </p>
      <p class="mt-7 text-lg text-[var(--color-foreground)]/80 leading-relaxed">
        Don't see your question here? <a href="/contact">Contact us</a> for general information.
      </p>
    </div>
  </section>

  <section class="pb-20 md:pb-28 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="mb-10">
        <AfterHoursCard />
      </div>

      <div class="space-y-3">
        {faqs.map(({ q, a }, idx) => (
          <details
            class="group card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] open:bg-[var(--color-card)] [&[open]_.faq-chevron]:rotate-180"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <h2 class="text-lg md:text-xl font-bold pr-2">{q}</h2>
              <span
                class="faq-chevron shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] [transition:transform_var(--duration-base)_var(--ease-fluid)]"
                aria-hidden="true"
              >
                <Icon name="lucide:chevron-down" class="w-5 h-5" stroke-width="2" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-[var(--color-foreground)]/85 leading-relaxed">
              <p>{a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
