---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import AfterHoursCard from '../components/AfterHoursCard.astro';
import { Icon } from 'astro-icon/components';
import { GOOGLE_DIRECTIONS_URL, SITE } from '../site.config';
import { getMedicalScheduling } from '../utils/serviceScheduling';

interface FaqItem {
  id: string;
  q: string;
  a: string;
  link?: { href: string; label: string };
}

const saturdayHours = SITE.hours.find(({ day }) => day === 'Saturday');
const languages = SITE.provider.quickFacts.find(({ label }) => label === 'Languages');
const medicalScheduling = getMedicalScheduling(SITE);
const dateFormat = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;
const openingTarget = new Date(SITE.openingTargetDate).toLocaleDateString('en-US', dateFormat);
const bookingTargets = [...new Set([SITE.newbornScheduling.plannedLaunchDate, SITE.wellChildScheduling.plannedLaunchDate])]
  .map((date) => new Date(date).toLocaleDateString('en-US', dateFormat)).join(' and ');
const faqs: FaqItem[] = [
  {
    id: 'opening',
    q: 'When are you opening?',
    a: `Our target opening in ${SITE.locationShort} is ${openingTarget}, subject to readiness. This is not a confirmed opening date; we will share updates as preparations are completed.`,
    link: { href: '/#practice-updates', label: 'Get opening updates' },
  },
  {
    id: 'booking',
    q: "How do I schedule my child's first checkup?",
    a: medicalScheduling.enabled
      ? 'Online booking is available for selected medical visit types. The practice is not open yet. The New Patients guide links to approved scheduling options; confirm appointment dates, insurance, and costs before booking.'
      : `Online medical booking is targeted for ${bookingTargets}, subject to confirmation. Appointments are not available yet. The New Patients guide explains how to prepare for a first checkup.`,
    link: { href: '/new-patients/', label: 'Read the first-visit guide' },
  },
  {
    id: 'choosing-luma',
    q: 'How do I choose Luma for my family?',
    a: 'Start with the physician introduction on our About page, then review planned services, insurance status, and the first-visit guide. If you would like to meet the pediatrician before choosing care, a Free Meet & Greet is planned after opening.',
    link: { href: '/new-patients/', label: 'Plan your first visit' },
  },
  {
    id: 'well-child-or-sick',
    q: 'What is the difference between a well-child and sick visit?',
    a: 'Well-child visits focus on preventive care, growth, development, and age-appropriate guidance. Sick visits address a current illness or symptom. Additional concerns may need separate time, follow-up, or services.',
    link: { href: '/well-child-visits/', label: 'Explore Well-Child Visits' },
  },
  ...(SITE.showProviderProfile ? [{
    id: 'pediatrician',
    q: 'Who is the pediatrician at Luma?',
    a: `${SITE.provider.name} is Luma’s founder and a board-certified pediatrician. She trained at ${SITE.provider.education[0]} and ${SITE.provider.education[1]}, and has cared for North Texas families since 2022.`,
    link: { href: '/about/', label: 'Get to know our pediatrician' },
  }] : []),
  {
    id: 'ages',
    q: 'What ages will Luma see?',
    a: 'Newborns through young adults, typically up to age 21, after the practice opens.',
  },
  {
    id: 'insurance',
    q: 'Which insurance plans will you accept?',
    a: medicalScheduling.enabled
      ? 'Insurance credentialing is in progress. Confirmed plans will be published once credentialing is complete. Verify coverage and costs before booking.'
      : 'Insurance credentialing is in progress. The confirmed list will be published before scheduling opens.',
    link: { href: '/new-patients/#insurance', label: 'Check insurance status' },
  },
  {
    id: 'self-pay',
    q: 'Will Luma see self-pay patients?',
    a: medicalScheduling.enabled
      ? 'Self-pay care is planned after opening. Booking is available for selected medical visits; contact the office to confirm fees before booking.'
      : 'Self-pay care is planned after opening. Appointments and fee information are not available yet.',
    link: { href: '/new-patients/#insurance', label: 'Read about insurance and self-pay' },
  },
  {
    id: 'same-day-visits',
    q: 'Do you offer same-day sick visits?',
    a: 'Same-day sick visits are planned after opening, when capacity allows, for fevers, infections, and minor injuries. Scheduling details are not available yet.',
  },
  {
    id: 'telehealth',
    q: 'Do you offer telehealth / virtual visits?',
    a: 'After opening, we plan to offer secure telehealth follow-ups for appropriate established-patient needs when an in-person exam is not required.',
  },
  ...(saturdayHours ? [{
    id: 'saturday-hours',
    q: 'Is Luma open on Saturdays?',
    a: `Not yet. Saturday hours are planned for ${saturdayHours.time} after opening. ${medicalScheduling.enabled ? 'The practice is not open yet.' : 'Appointments are not available yet.'}`,
    link: { href: '/contact/#planned-hours', label: 'View planned office hours' },
  }] : []),
  {
    id: 'hospital-newborn-care',
    q: 'Will Luma see my newborn in the hospital?',
    a: 'Newborn rounds at Baylor Scott & White Medical Center in McKinney are planned after opening and completion of hospital arrangements, subject to assignment and privileges. This does not guarantee attendance at every delivery or care for every newborn there. Newborn office visits for feeding, growth, weight, and jaundice follow-up are separate.',
    link: { href: '/newborn-care/', label: 'Explore newborn office care' },
  },
  {
    id: 'meet-and-greet',
    q: 'What is the free Meet & Greet?',
    a: 'A complimentary introduction to meet the pediatrician and learn about the practice before choosing care—not a medical appointment or the start of a physician-patient relationship. It is planned after opening; arrangements and booking are not available yet.',
    link: { href: '/meet-and-greet/', label: 'Explore the planned Free Meet & Greet' },
  },
  ...(SITE.showProviderProfile && languages ? [{
    id: 'languages',
    q: 'Does the pediatrician speak Telugu, Hindi, or Urdu?',
    a: `${SITE.provider.shortName}: ${languages.value}.`,
  }] : []),
  {
    id: 'location',
    q: 'Where will the office be?',
    a: `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.region} ${SITE.address.postalCode}, just off US-75. The practice is not currently open.`,
    link: { href: GOOGLE_DIRECTIONS_URL, label: 'Get directions to the future office' },
  },
  {
    id: 'service-area',
    q: 'Which communities will Luma serve?',
    a: 'The future practice is intended for families in McKinney and nearby communities, including Allen, Frisco, Prosper, Melissa, Princeton, Anna, and Fairview. Luma will have one clinic in McKinney.',
    link: { href: '/pediatrician/', label: 'Explore the McKinney location and service area' },
  },
  {
    id: 'first-visit',
    q: 'What should I bring to a first visit?',
    a: 'Bring a photo ID, your insurance card, your child\'s immunization records (if available), and any forms that need to be signed. For newborns, bring the discharge paperwork from the hospital.',
    link: { href: '/new-patients/#what-to-bring', label: 'See the first-visit checklist' },
  },
  {
    id: 'physicals',
    q: 'Do you do school, sports, and camp physicals?',
    a: 'After opening, we plan to offer school, sports, and camp physicals as part of appropriate well-child care.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout
  title="FAQ | Luma Pediatrics McKinney"
  path="/faq"
  description={`Common questions about ${SITE.name} in McKinney, TX: insurance, planned same-day visits, first appointments, ages we see, and our opening. ${SITE.status}.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">FAQ</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Questions before choosing Luma
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        Opening, insurance, appointments, and what to expect.
      </p>
      <p class="mt-7 text-lg text-[var(--color-foreground)]/80 leading-relaxed">
        Don't see your question here? <a href="/contact/">Contact us</a> for general information.
      </p>
    </div>
  </section>

  <section class="pb-20 md:pb-28 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div id="after-hours" class="mb-10 scroll-mt-32">
        <AfterHoursCard />
      </div>

      <div class="space-y-3">
        {faqs.map(({ id, q, a, link }, idx) => (
          <details
            id={id}
            data-faq-answer
            class="group card-lift scroll-mt-32 rounded-[var(--radius-card)] bg-[var(--color-card)] open:bg-[var(--color-card)] [&[open]_.faq-chevron]:rotate-180"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <h2 class="text-lg md:text-xl font-bold pr-2">{q}</h2>
              <span
                class="faq-chevron shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] [transition:transform_var(--duration-base)_var(--ease-fluid)]"
                aria-hidden="true"
              >
                <Icon name="lucide:chevron-down" class="w-5 h-5" stroke-width="2" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-[var(--color-foreground)]/85 leading-relaxed">
              <p>{a}</p>
              {link && (
                <a href={link.href} class="mt-3 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">{link.label}</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script>
    const openLinkedAnswer = () => {
      const answer = document.getElementById(window.location.hash.slice(1));
      if (answer instanceof HTMLDetailsElement && answer.matches('[data-faq-answer]')) {
        answer.open = true;
      }
    };
    openLinkedAnswer();
    window.addEventListener('hashchange', openLinkedAnswer);
  </script>
</BaseLayout>
