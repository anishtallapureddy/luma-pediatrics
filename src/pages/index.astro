---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import StarDivider from '../components/StarDivider.astro';
import SparkleField from '../components/SparkleField.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { Icon } from 'astro-icon/components';
import { GOOGLE_DIRECTIONS_URL, SITE } from '../site.config';
import { featuredServices as services } from '../data/services';
import Picture from '../components/Picture.astro';
import { getMedicalScheduling } from '../utils/serviceScheduling';

const medicalScheduling = getMedicalScheduling(SITE);
const familyBenefits = [
  {
    title: 'Your concerns are heard.',
    body: 'Time to discuss your child’s health and questions with a board-certified pediatrician.',
  },
  {
    title: 'You understand the plan.',
    body: 'Clear explanations of care recommendations and practical guidance on what to do next.',
  },
  {
    title: 'Care as your child grows.',
    body: 'Guidance on feeding, development, school, and healthy habits through the teen years.',
  },
];

const serviceGroups = [
  {
    title: 'Getting started',
    description: 'Ways to meet Luma and support your baby’s earliest days.',
    serviceTitles: [
      'Free Meet & Greet',
      'Newborn Care',
    ],
  },
  {
    title: 'Everyday pediatric care',
    description: 'Preventive care, sick visits, and recommended protection as children grow.',
    serviceTitles: [
      'Well-Child Visits',
      'Same-Day Sick Visits',
      'Vaccinations',
    ],
  },
].map((group) => ({
  ...group,
  services: services.filter((service) =>
    group.serviceTitles.includes(service.title),
  ),
}));

const trustPhotos = [
  {
    src: '/images/trust-family.jpg',
    alt: 'A mother cuddling her happy laughing baby in a soft, sunlit nursery',
  },
  {
    src: '/images/trust-checkup.jpg',
    alt: 'A pediatrician using a stethoscope on a smiling girl held by her mother',
  },
  {
    src: '/images/trust-gentle.jpg',
    alt: 'A smiling young girl using a stethoscope to listen to her teddy bear',
  },
  {
    src: '/images/trust-playful.jpg',
    alt: 'A happy toddler sitting on a rug, surrounded by a teddy bear, bunny, and stacking toys',
  },
];
---
<BaseLayout
  title="Luma Pediatrics | Pediatric Primary Care in McKinney, TX"
  path="/"
  description={`Board-certified pediatric care planned for newborns through teens in McKinney, TX. ${SITE.name} opens late 2026 with well visits, sick care, vaccines, and more.`}
  socialTitle="Luma Pediatrics | McKinney, TX"
  socialDescription={`Helping kids thrive. Helping parents feel confident. Thoughtful pediatric care planned for McKinney, Texas. ${SITE.status}.`}
  ogImageAlt={`Luma Pediatrics logo. ${SITE.status} in McKinney, Texas.`}
  preloadImage="/images/luma-hero-banner.webp"
>

  <!-- HERO - outcome-led copy, approved imagery, and family-focused benefits. -->
  <section class="brand-hero overflow-hidden" data-home-section="hero">
    <div class="brand-cloud cloud-left" aria-hidden="true"></div>
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-left" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={12} class="z-0" />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10 flex-1 flex items-center">
      <div class="fade-up grid gap-8 lg:grid-cols-2 items-center w-full">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.08]" style="font-family: var(--font-display);">
            <span class="block">Helping kids thrive.</span>{' '}
            <span class="block">Helping parents feel confident.</span>
          </h1>
          <div class="mt-3 lg:max-w-xs">
            <StarDivider span="4rem" />
          </div>
          <p class="mt-3 text-sm md:text-base text-[var(--color-foreground)]/80 max-w-xl mx-auto lg:mx-0 leading-relaxed">
            From newborn checkups and well-child visits to sick care and the teen years, Luma Pediatrics is preparing to welcome McKinney families with thoughtful care, clear answers, and a personal approach to your child's health.
          </p>

          <div class="mt-6 flex flex-wrap justify-center lg:justify-start gap-3">
            <Button href="/new-patients/" variant="primary">
              Plan Your Child's Visit
              <span class="btn-icon-circle" aria-hidden="true">
                <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
              </span>
            </Button>
            <Button href="/about/" variant="secondary">{SITE.showProviderProfile ? 'Meet Dr. Tallapureddy' : 'About Luma'}</Button>
          </div>
        </div>

        <figure class="hero-poster-image hero-poster-image--wide" data-home-visual>
          <Picture
            src="/images/luma-hero-banner.jpg"
            alt="Luma Pediatrics logo above the words Where your child's health shines, set in a sunlit nursery with a teddy bear, stacked books, and a wooden rainbow"
            width={1440}
            height={753}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>

    <div class="hero-credibility-ribbon">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 grid gap-6 md:grid-cols-3" data-family-benefits>
        {familyBenefits.map(({ title, body }) => (
          <div>
            <h2 class="text-xl font-semibold leading-snug text-[var(--color-sage-foreground)]">{title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-sage-foreground)]">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    class="home-section-nav reveal"
    data-home-section="credibility"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav
        class="flex flex-wrap justify-center gap-2"
        aria-label="Explore homepage sections"
      >
        {[
          { href: '#services', label: 'Care' },
          { href: '#why-luma', label: 'Why Luma' },
          { href: '#plan-ahead', label: 'Plan ahead' },
          { href: '#practice-updates', label: 'Get updates' },
        ].map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-9 items-center rounded-full bg-[var(--color-card)] px-3.5 text-sm font-semibold text-[var(--color-primary)] no-underline ring-1 ring-inset ring-[var(--color-border-soft)] hover:bg-[var(--color-muted)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section
    id="services"
    class="scroll-mt-32 py-20 md:py-28 reveal relative"
    data-home-section="services"
  >
    <SparkleField count={6} />
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="eyebrow">Planned care</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight">Checkups, sick care, and growing up.</h2>
        <p class="mt-5 tagline-italic-sage text-lg md:text-xl">
          Find the care you’re looking for and see what we’re planning.
        </p>
      </div>

      <div class="space-y-14">
        {serviceGroups.map((group) => (
          <section>
            <div class="mb-6 max-w-2xl">
              <h3 class="text-2xl md:text-3xl tracking-tight">{group.title}</h3>
              <p class="mt-2 text-[var(--color-foreground)]/70 leading-relaxed">
                {group.description}
              </p>
            </div>
            <div class:list={['grid gap-5 sm:grid-cols-2', group.services.length > 2 && 'lg:grid-cols-3']}>
              {group.services.map(({ slug, icon, title, short, badge, detailHref }) => (
                <a
                  href={detailHref ?? `/services/#${slug}`}
                  class="card-lift group flex h-full flex-col rounded-[var(--radius-card)] bg-[var(--color-card)] p-7 text-[var(--color-foreground)] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
                  aria-label={`Learn more about ${title}`}
                >
                  <span
                    class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] mb-5 ring-1 ring-inset ring-[rgba(200, 153, 90,0.30)]"
                    style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
                  >
                    <Icon name={icon} class="w-6 h-6" stroke-width="1.6" aria-hidden="true" />
                  </span>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 class="text-2xl font-semibold" style="font-family: var(--font-display);">{title}</h4>
                    {badge && (
                      <span class="service-badge">{badge}</span>
                    )}
                  </div>
                  <p class="mt-2.5 text-[var(--color-foreground)]/80 leading-relaxed">{short}</p>
                  <span class="mt-auto pt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)]">
                    Learn more
                    <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="mt-12 text-center">
        <Button href="/services/" variant="secondary">
          See all services
          <span class="btn-icon-circle" aria-hidden="true">
            <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
          </span>
        </Button>
      </div>
    </div>
  </section>

  <section
    id="why-luma"
    class="trust-gallery scroll-mt-32 py-20 md:py-28 reveal"
    data-home-section="why-luma"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="eyebrow eyebrow-sun">Why Luma</span>
        <h2 class="mt-5 text-4xl md:text-6xl tracking-tight">
          Why consider Luma?
        </h2>
        <p class="mt-6 text-lg text-[var(--color-foreground)]/78 leading-relaxed max-w-2xl mx-auto">
          Get to know our approach to children’s health and the questions families bring to each stage.
        </p>
      </div>

      <div
        class="trust-photo-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
        tabindex="0"
        aria-label="Family-centered practice gallery"
      >
        {trustPhotos.map(({ src, alt }) => (
          <figure class="photo-trust-card card-lift">
            <Picture
              src={src}
              alt={alt}
              width={1200}
              height={1005}
              loading="lazy"
            />
          </figure>
        ))}
      </div>

      <p class="mt-6 text-center">
        <a href="/about/" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">
          Get to know our pediatrician →
        </a>
      </p>

    </div>
  </section>

  <section
    id="plan-ahead"
    class="scroll-mt-32 py-20 md:py-24 bg-[var(--color-muted)] reveal"
    data-home-section="practical"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="eyebrow eyebrow-sun">Plan ahead</span>
        <h2 class="mt-5 text-3xl md:text-4xl tracking-tight">
          Before your first visit
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-9">
          <span class="eyebrow eyebrow-sun">Insurance</span>
          <h3 class="mt-5 text-2xl md:text-3xl tracking-tight">
            Will Luma accept my insurance?
          </h3>
          <p class="mt-5 text-[var(--color-foreground)]/80 leading-relaxed">
            Insurance credentialing is in progress. {medicalScheduling.enabled ? 'Confirmed plans will be published once credentialing is complete.' : 'We’ll publish confirmed plans before scheduling opens.'} Self-pay options are also planned.
          </p>
          <a href="/new-patients/#insurance" class="mt-6 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline-offset-4 hover:underline">
            See insurance and first-visit details →
          </a>
        </article>

        <article
          id="visit-us"
          class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-9"
        >
          <div class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.30)]" aria-hidden="true">
              <Icon name="lucide:map-pin" class="w-5 h-5" stroke-width="1.8" />
            </span>
            <div>
              <span class="eyebrow eyebrow-sun">Visit us</span>
              <h3 class="mt-3 text-2xl md:text-3xl tracking-tight">
                Our future McKinney home
              </h3>
              <address class="mt-3 not-italic text-[var(--color-foreground)]/85 leading-relaxed">
                {SITE.address.street}<br />
                {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
              </address>
              <p class="mt-2 text-sm text-[var(--color-muted-foreground)]">
                Conveniently located just off US-75.
              </p>
            </div>
          </div>
          <a
            href={GOOGLE_DIRECTIONS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-[var(--color-primary-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
            aria-label={`Get directions to ${SITE.name}`}
          >
            <Icon name="lucide:map-pin" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
            Get directions
          </a>
        </article>
      </div>

      <p class="mt-8 text-center">
        <a href="/new-patients/" class="font-semibold text-[var(--color-primary)] underline-offset-4 hover:underline">
          Planning a future first visit? View the new-patient guide →
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20 reveal" data-home-section="updates">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <WaitlistForm variant="hero" />
    </div>
  </section>

  <!-- ====================================================================
       FINAL CTA, "Still have questions?" pairing FAQ + Contact, instead of
       duplicating the hero. Keeps a strong close without repeating CTAs.
       ==================================================================== -->
  <section class="campaign-panel" data-home-section="final">
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={10} />

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 text-center">
      <div class="campaign-card px-5 py-12 md:p-14">
        <span class="eyebrow eyebrow-sun">Have a question?</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight" style="font-family: var(--font-display);">
          Still have a question?
        </h2>
        <StarDivider class="mt-7" span="3rem" />
        <p class="mt-7 text-base md:text-lg text-[var(--color-foreground)]/78 max-w-2xl mx-auto leading-relaxed">
          Find answers about insurance, planned hours, and first visits. Contact us for general questions not covered there.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <Button href="/faq/" variant="primary">
            <Icon name="lucide:info" class="w-5 h-5" stroke-width="1.6" />
            Browse FAQs
          </Button>
          <Button href="/contact/" variant="secondary">
            Contact us
            <span class="btn-icon-circle" aria-hidden="true">
              <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
            </span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
