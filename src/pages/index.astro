---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import StarDivider from '../components/StarDivider.astro';
import SparkleField from '../components/SparkleField.astro';
import { Icon } from 'astro-icon/components';
import { GOOGLE_DIRECTIONS_URL, SITE } from '../site.config';
import { featuredServices as services } from '../data/services';
import Picture from '../components/Picture.astro';
import { getMedicalScheduling } from '../utils/serviceScheduling';
const { appointments } = getMedicalScheduling(SITE);
const appointmentsStartDate = new Date(`${SITE.openingDate}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
const familyBenefits = [
  {
    title: 'Your concerns are heard.',
    body: 'We take time to listen, answer your questions, and understand what matters most to your family.',
    src: '/images/trust-checkup.jpg',
    alt: SITE.showProviderProfile
      ? 'Dr. Tallapureddy using a stethoscope on a smiling girl held by her mother'
      : 'A pediatrician using a stethoscope on a smiling girl held by her mother',
  },
  {
    title: 'You understand the plan.',
    body: 'Clear explanations and practical guidance so you leave each visit knowing what comes next.',
    src: '/images/trust-gentle.jpg',
    alt: 'A smiling young girl using a stethoscope to listen to her teddy bear',
  },
  {
    title: 'Care as your child grows.',
    body: 'From newborn days through the teen years, we’re here to support your child’s health and development at every stage.',
    src: '/images/trust-playful.jpg',
    alt: 'A happy toddler sitting on a rug, surrounded by a teddy bear, bunny, and stacking toys',
  },
];

const homeServiceSlugs = ['well-child-visits', 'sick-visits', 'newborn-care', 'vaccinations'];
const homeServices = homeServiceSlugs.flatMap((slug) => services.filter((service) => service.slug === slug));
---
<BaseLayout
  title="Luma Pediatrics | Pediatric Primary Care in McKinney, TX"
  path="/"
  description={`Board-certified pediatric care for newborns through teens in McKinney, TX. ${SITE.status}. Book newborn, well-child, and sick visits online through Phreesia.`}
  socialTitle="Luma Pediatrics | McKinney, TX"
  socialDescription={`Helping kids thrive and parents feel confident. Thoughtful pediatric care in McKinney, Texas. ${SITE.status}. Book an appointment online.`}
  ogImageAlt={`Luma Pediatrics logo. ${SITE.status}.`}
  preloadImage="/images/luma-hero-banner.webp"
>

  <!-- HERO - outcome-led copy, approved imagery, and family-focused benefits. -->
  <section class="brand-hero overflow-hidden" data-home-section="hero">
    <div class="brand-cloud cloud-left" aria-hidden="true"></div>
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-left" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={12} class="z-0" />

    <div class="site-container relative z-10 py-8 md:py-10 flex-1 flex items-center">
      <div class="fade-up grid gap-8 lg:grid-cols-2 items-center w-full">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.08]" style="font-family: var(--font-display);">
            <span class="lg:block">Helping kids thrive</span>{' '}
            <span class="lg:block">and parents feel confident.</span>
          </h1>
          <div class="mt-3 lg:max-w-xs">
            <StarDivider span="4rem" />
          </div>
          <p class="mt-3 text-sm md:text-base text-[var(--color-foreground)]/80 mx-auto lg:mx-0 leading-relaxed">
            {SITE.showProviderProfile ? 'Board-certified pediatrician Dr. Praveena Tallapureddy provides' : 'Our board-certified pediatrician provides'} personalized, evidence-based care for children from birth through age 21. {SITE.status}.
          </p>
          <p class="mt-3 text-sm md:text-base font-semibold text-[var(--color-primary)]">
            Insurance accepted. No membership fee.
          </p>

          <div class="mt-6 flex flex-wrap justify-center lg:justify-start gap-3" data-hero-cta>
            <Button href={appointments.href} variant="primary">
              {appointments.label}
              <span class="btn-icon-circle" aria-hidden="true">
                <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
              </span>
            </Button>
            <Button href="/about/" variant="secondary">{SITE.showProviderProfile ? 'About Dr. Tallapureddy' : 'About Luma'}</Button>
          </div>
        </div>

        <figure class="hero-poster-image hero-poster-image--wide" data-home-visual>
          <Picture
            src="/images/luma-hero-banner.jpg"
            alt="Luma Pediatrics logo above the words Where your child's health shines, set in a sunlit nursery with a teddy bear, stacked books, and a wooden rainbow"
            width={1440}
            height={753}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  {appointments.enabled && (
    <section
      id="schedule"
      class="scroll-mt-32 pt-14 md:pt-20 reveal"
      data-home-section="scheduling"
    >
      <div class="site-container">
        <div class="home-scheduling-card mx-auto max-w-3xl rounded-[var(--radius-card)] bg-[var(--color-card)] p-8 md:p-12 text-center ring-1 ring-inset ring-[var(--color-border-soft)]">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[var(--color-border-soft)]">
            <Icon name="lucide:calendar-check" class="w-6 h-6" stroke-width="1.6" aria-hidden="true" />
          </span>
          <h2 class="mt-5 text-3xl md:text-5xl tracking-tight">Scheduling Made Simple</h2>
          <p class="mt-5 text-lg leading-relaxed text-[var(--color-foreground)]/85">
            Your family’s schedule is busy. Booking a pediatric appointment shouldn’t be.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-[var(--color-foreground)]/85">
            Schedule well-child visits, sick appointments, and follow-up care online, anytime. Just choose a date and time that works for you.
          </p>
          <div class="mt-8 flex justify-center">
            <Button href={appointments.href} variant="primary">
              {appointments.label}
              <span class="btn-icon-circle" aria-hidden="true">
                <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
              </span>
            </Button>
          </div>
          {SITE.appointmentScheduling.showStartNote && (
            <p class="mt-4 text-sm text-[var(--color-muted-foreground)]" data-appointments-start-note>
              Appointments available beginning {appointmentsStartDate}.
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <section
    id="services"
    class="scroll-mt-32 py-20 md:py-24 reveal relative"
    data-home-section="services"
  >
    <SparkleField count={6} />
    <div class="site-container relative">
      <div class="mx-auto text-center mb-12">
        <span class="eyebrow">Our care</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight">Checkups, sick care, and growing up.</h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {homeServices.map(({ slug, icon, title, short, badge, detailHref }) => (
          <a
            href={detailHref ?? `/services/#${slug}`}
            class="card-lift group flex h-full flex-col rounded-[var(--radius-card)] bg-[var(--color-card)] p-6 text-[var(--color-foreground)] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
            aria-label={`Learn more about ${title}`}
          >
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] mb-5 ring-1 ring-inset ring-[var(--color-border-soft)]"
              style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
            >
              <Icon name={icon} class="w-6 h-6" stroke-width="1.6" aria-hidden="true" />
            </span>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-2xl font-semibold" style="font-family: var(--font-display);">{title}</h3>
              {badge && (
                <span class="service-badge">{badge}</span>
              )}
            </div>
            <p class="mt-2.5 text-[var(--color-foreground)]/80 leading-relaxed">{short}</p>
            <span class="mt-auto pt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)]">
              Learn more
              <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center">
        <Button href="/services/" variant="secondary">
          See all services
          <span class="btn-icon-circle" aria-hidden="true">
            <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
          </span>
        </Button>
      </div>
    </div>
  </section>

  <section
    id="why-luma"
    class="trust-gallery scroll-mt-32 py-20 md:py-24 reveal"
    data-home-section="why-luma"
  >
    <div class="site-container">
      <div class="mx-auto text-center mb-12">
        <span class="eyebrow eyebrow-sun">Why Luma</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight">
          What to expect at Luma
        </h2>
      </div>

      <div
        class="trust-photo-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
        tabindex="0"
        aria-label="What to expect at Luma"
        data-family-benefits
      >
        {familyBenefits.map(({ title, body, src, alt }) => (
          <figure class="photo-trust-card card-lift">
            <Picture
              src={src}
              alt={alt}
              width={1200}
              height={1005}
              loading="lazy"
            />
            <figcaption>
              <h3>{title}</h3>
              <p>{body}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="mt-8 text-center">
        <a href="/about/" class="inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline underline-offset-4">
          {SITE.showProviderProfile ? 'Meet Dr. T →' : 'Meet our pediatrician →'}
        </a>
      </p>
    </div>
  </section>

  <section
    id="plan-ahead"
    class="campaign-panel scroll-mt-32 reveal"
    data-home-section="practical"
  >
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={8} />

    <div class="site-container relative z-10 py-20 md:py-24">
      <div class="mx-auto text-center mb-12">
        <span class="eyebrow eyebrow-sun">Plan ahead</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight" style="font-family: var(--font-display);">
          Before your first visit
        </h2>
        <StarDivider class="mt-6" span="3rem" />
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-9">
          <span class="eyebrow eyebrow-sun">Insurance &amp; self-pay</span>
          <h3 class="mt-5 text-2xl md:text-3xl tracking-tight">
            Does Luma accept my insurance?
          </h3>
          <p class="mt-5 text-[var(--color-foreground)]/80 leading-relaxed">
            We accept a variety of insurance plans and offer straightforward self-pay pricing. Check our participating plans online, or text us if you have questions about coverage.
          </p>
          <a href="/new-patients/#insurance" class="mt-6 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline-offset-4 hover:underline">
            View insurance &amp; self-pay details →
          </a>
        </article>

        <article
          id="visit-us"
          class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-9"
        >
          <div class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.30)]" aria-hidden="true">
              <Icon name="lucide:map-pin" class="w-5 h-5" stroke-width="1.8" />
            </span>
            <div>
              <span class="eyebrow eyebrow-sun">Visit us</span>
              <h3 class="mt-3 text-2xl md:text-3xl tracking-tight">
                Our McKinney home
              </h3>
              <address class="mt-3 not-italic text-[var(--color-foreground)]/85 leading-relaxed">
                {SITE.address.street}<br />
                {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
              </address>
              <p class="mt-2 text-sm text-[var(--color-muted-foreground)]">
                Conveniently located just off US-75.
              </p>
            </div>
          </div>
          <a
            href={GOOGLE_DIRECTIONS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-[var(--color-primary-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
            aria-label={`Get directions to ${SITE.name}`}
          >
            <Icon name="lucide:map-pin" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
            Get directions
          </a>
        </article>
      </div>

      <aside
        class="mt-6 flex flex-col gap-4 rounded-[var(--radius-card)] bg-[var(--color-card)] p-7 ring-1 ring-[var(--color-border-soft)] md:flex-row md:items-start md:p-9"
        aria-labelledby="first-visit-prep-heading"
        data-first-visit-prep
      >
        <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.30)]" aria-hidden="true">
          <Icon name="lucide:clipboard-list" class="w-5 h-5" stroke-width="1.8" />
        </span>
        <div>
          <h3 id="first-visit-prep-heading" class="text-2xl tracking-tight">Getting ready for your first visit?</h3>
          <p class="mt-3 text-[var(--color-foreground)]/80 leading-relaxed">
            We’ll text you a link to complete registration and paperwork before your appointment. If your child has seen another pediatrician, we’ll help request their medical records with your authorization. For well-child visits, please bring a copy of your child’s vaccination record.
          </p>
          <a href="/new-patients/" class="mt-4 inline-flex min-h-11 items-center font-semibold text-[var(--color-primary)] underline-offset-4 hover:underline">
            View our new-patient guide →
          </a>
        </div>
      </aside>

      <div class="mt-12 text-center">
        <p class="text-lg text-[var(--color-foreground)]/80">Still have a question?</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <Button href="/faq/" variant="secondary">Browse FAQs</Button>
          <Button href="/contact/" variant="ghost">Contact us</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
