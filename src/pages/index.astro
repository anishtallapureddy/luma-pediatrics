---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import StarDivider from '../components/StarDivider.astro';
import SageWave from '../components/SageWave.astro';
import SparkleField from '../components/SparkleField.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { Icon } from 'astro-icon/components';
import { GOOGLE_DIRECTIONS_URL, SITE } from '../site.config';
import { services as serviceCatalog } from '../data/services';
import Picture from '../components/Picture.astro';

const homeServiceTitles = new Set([
  'Newborn Care',
  'Well-Child Visits',
  'Sick Visits',
  'Vaccinations',
  'ADHD, Behavior & Developmental Care',
  'Teen & Adolescent Health',
]);
const homeServices = serviceCatalog.filter((service) =>
  homeServiceTitles.has(service.title),
);

const promises = [
  {
    icon: 'lucide:clock',
    title: 'Time for questions',
    body: 'Appointments will be planned with enough time to listen, explain options, and agree on next steps.',
  },
  {
    icon: 'lucide:users',
    title: 'Continuity of care',
    body: 'Families will see the same pediatrician and build a consistent relationship over time.',
  },
  {
    icon: 'lucide:heart',
    title: 'Partnership with parents',
    body: 'Parents bring essential knowledge of their child. We provide clear medical guidance and make decisions together.',
  },
];

---
<BaseLayout
  title="Luma Pediatrics | Pediatric Primary Care in McKinney, TX"
  path="/"
  description={`${SITE.name} is a board-certified pediatric practice in McKinney, TX. ${SITE.status}. Planned services include well-child visits, same-day sick care, vaccinations, school physicals, and ADHD/behavioral support.`}
  socialTitle="Luma Pediatrics | McKinney, TX"
  socialDescription={`Expert pediatric care that feels like family. ${SITE.status} in McKinney, Texas.`}
  ogImageAlt={`Luma Pediatrics. Expert pediatric care that feels like family. ${SITE.status} in McKinney, Texas.`}
>

  <!-- ====================================================================
       HERO - elegant brand vibe: centered logo + serif wordmark + italic
       gold tagline, gold sparkles scattered, sage-curved transition below.
       ==================================================================== -->
  <section class="brand-hero overflow-hidden">
    <div class="brand-cloud cloud-left" aria-hidden="true"></div>
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-left" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={8} class="z-0" />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex-1 flex items-center">
      <div class="fade-up grid gap-8 lg:grid-cols-[0.92fr_1.08fr] items-center w-full">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-6xl font-semibold tracking-tight leading-[0.98]" style="font-family: var(--font-display);">
            Expert pediatric care that feels like family.
          </h1>
          <div class="mt-5 lg:max-w-xs">
            <StarDivider span="4rem" />
          </div>
          <p class="mt-5 text-lg md:text-2xl tagline-italic-sage leading-snug">
            Where your child's health shines.
          </p>
          <p class="mt-4 text-sm md:text-base text-[var(--color-foreground)]/74 max-w-xl md:max-w-none mx-auto lg:mx-0 leading-relaxed lg:whitespace-nowrap">
            Planned care for newborns to teens, conveniently located just off US-75.
          </p>

          <div class="mt-6 flex flex-wrap justify-center lg:justify-start gap-3">
            <Button href="/services" variant="primary">
              Explore services
              <span class="btn-icon-circle" aria-hidden="true">
                <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
              </span>
            </Button>
            <Button href="/contact" variant="secondary">Get in touch</Button>
          </div>

          <dl class="mt-8 grid gap-3 border-t border-[var(--color-border-soft)] pt-5 text-left sm:grid-cols-3">
            <div>
              <dt class="sr-only">Credential</dt>
              <dd class="flex items-center gap-2 text-sm font-semibold text-[var(--color-foreground)]">
                <Icon name="lucide:award" class="w-4 h-4 text-[var(--color-sun)]" stroke-width="1.8" aria-hidden="true" />
                Board-certified
              </dd>
            </div>
            <div>
              <dt class="sr-only">Continuity</dt>
              <dd class="flex items-center gap-2 text-sm font-semibold text-[var(--color-foreground)]">
                <Icon name="lucide:users" class="w-4 h-4 text-[var(--color-sage)]" stroke-width="1.8" aria-hidden="true" />
                One consistent physician
              </dd>
            </div>
            <div>
              <dt class="sr-only">Location</dt>
              <dd class="flex items-center gap-2 text-sm font-semibold text-[var(--color-foreground)]">
                <Icon name="lucide:map-pin" class="w-4 h-4 text-[var(--color-sun)]" stroke-width="1.8" aria-hidden="true" />
                McKinney, Texas
              </dd>
            </div>
          </dl>
        </div>

        <figure class="hero-family-photo">
          <Picture
            src="/images/warm-family.jpg"
            alt="A mother holding her smiling baby in a warm nursery"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <Icon name="lucide:heart" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
            Relationship-centered care from newborns through young adulthood
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="sage-sweep" aria-hidden="true"></div>
    <!-- Sage wave transition into the next section -->
    <SageWave direction="down" height={38} />
  </section>

  <!-- ====================================================================
       WHY LUMA, one visual and three clear principles.
       ==================================================================== -->
  <section class="trust-gallery py-20 md:py-28 reveal">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <figure class="overflow-hidden rounded-[2rem] bg-[var(--color-card)] shadow-[var(--shadow-elevated)]">
        <Picture
          src="/images/hero-child.jpg"
          alt="A young child hugging a teddy bear in a warm, calm room"
          class="block w-full aspect-[4/3] object-cover"
          loading="lazy"
        />
      </figure>

      <div>
        <span class="eyebrow eyebrow-sun">A space for families</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight">
          Calm care, clear guidance, and one trusted relationship.
        </h2>
        <p class="mt-5 text-lg text-[var(--color-foreground)]/78 leading-relaxed">
          The future clinic is being designed around the people who know each child best, with thoughtful visits and room for questions.
        </p>

        <div class="mt-8 space-y-6">
          {promises.map(({ icon, title, body }) => (
            <div class="flex items-start gap-4">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.28)]" aria-hidden="true">
                <Icon name={icon} class="w-5 h-5" stroke-width="1.7" />
              </span>
              <div>
                <h3 class="text-xl font-semibold">{title}</h3>
                <p class="mt-1 text-[var(--color-foreground)]/75 leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <Button href="/about/" variant="secondary">
            Learn about our approach
            <span class="btn-icon-circle" aria-hidden="true">
              <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
            </span>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       SERVICES preview
       ==================================================================== -->
  <section id="services" class="py-20 md:py-28 reveal relative">
    <SparkleField count={4} />
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="eyebrow">Planned care</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight lg:whitespace-nowrap">Care from infancy through adolescence.</h2>
        <p class="mt-5 tagline-italic-sage text-lg md:text-xl">
          A focused preview of the care families will find at Luma.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {homeServices.map(({ icon, title, short, badge }) => (
          <article class="card-lift group rounded-[var(--radius-card)] bg-[var(--color-card)] p-7">
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] mb-5 ring-1 ring-inset ring-[rgba(200, 153, 90,0.30)]"
              style="box-shadow: inset 0 1px 1px rgba(255,255,255,0.6);"
            >
              <Icon name={icon} class="w-6 h-6" stroke-width="1.6" aria-hidden="true" />
            </span>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-2xl font-semibold" style="font-family: var(--font-display);">{title}</h3>
              {badge && (
                <span class="service-badge">{badge}</span>
              )}
            </div>
            <p class="mt-2.5 text-[var(--color-foreground)]/80 leading-relaxed">{short}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 text-center">
        <Button href="/services" variant="secondary">
          See all services
          <span class="btn-icon-circle" aria-hidden="true">
            <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
          </span>
        </Button>
      </div>
    </div>
  </section>

  {SITE.showProviderProfile && (
    <section class="py-20 md:py-28 reveal relative navy-campaign">
      <SparkleField count={4} />
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
        <figure class="overflow-hidden rounded-[2rem] border border-white/15 bg-white/5 shadow-[0_22px_55px_-30px_rgba(0,0,0,0.65)]">
          <Picture
            src="/images/provider-headshot.jpg"
            alt={`${SITE.provider.name}, ${SITE.provider.role} at ${SITE.name}`}
            class="block w-full aspect-[4/5] object-cover object-top"
            loading="lazy"
          />
        </figure>

        <div>
          <span class="eyebrow eyebrow-sun">Meet your pediatrician</span>
          <h2 class="mt-5 text-3xl md:text-5xl tracking-tight text-white">
            {SITE.provider.displayName}
          </h2>
          <p class="mt-3 text-lg font-semibold text-[var(--color-sun)]">
            {SITE.provider.role}
          </p>
          <p class="mt-5 max-w-2xl text-lg text-white/85 leading-relaxed">
            {SITE.provider.shortName} is building Luma around continuity, thoughtful visits, and clear guidance that respects each family’s questions and goals.
          </p>

          <dl class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/15 bg-white/5 p-4">
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-white/60">Board certification</dt>
              <dd class="mt-2 text-base font-semibold text-white">American Board of Pediatrics</dd>
            </div>
            <div class="rounded-2xl border border-white/15 bg-white/5 p-4">
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-white/60">Languages</dt>
              <dd class="mt-2 text-base font-semibold text-white">English, Telugu, Hindi &amp; Urdu</dd>
            </div>
          </dl>

          <div class="mt-8">
            <Button href="/about/" variant="secondary">
              Meet Dr. Tallapureddy
              <span class="btn-icon-circle" aria-hidden="true">
                <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
              </span>
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Practice updates, independent email opt-in -->
  <section class="py-16 md:py-20 reveal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <WaitlistForm variant="hero" />
    </div>
  </section>

  <!-- ====================================================================
       INSURANCE, gold-tinted band with elegant treatment
       ==================================================================== -->
  <section class="py-16 md:py-20 bg-[var(--color-muted)] reveal">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="eyebrow eyebrow-sun">Insurance</span>
      <h2 class="mt-5 text-3xl md:text-4xl tracking-tight">
        Care within reach for every family.
      </h2>
      <StarDivider class="mt-7" span="3rem" />
      <p class="mt-7 text-[var(--color-foreground)]/80 max-w-2xl mx-auto leading-relaxed text-lg">
        We're completing insurance credentialing now, the full list of accepted plans is coming soon. Self-pay families are welcome across North Texas communities, and we're glad to answer questions in the meantime.
      </p>
      <div class="mt-7">
        <a href="/contact" class="font-semibold text-[var(--color-primary)] underline-offset-4 hover:underline">
          Have insurance questions? Get in touch →
        </a>
      </div>
    </div>
  </section>

  <!-- Visit us -->
  <section id="visit-us" aria-labelledby="visit-us-title" class="py-16 md:py-20 reveal relative">
    <SparkleField count={4} />
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-7 md:p-9 grid gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-muted)] text-[var(--color-primary)] ring-1 ring-inset ring-[rgba(200,153,90,0.30)]" aria-hidden="true">
            <Icon name="lucide:map-pin" class="w-5 h-5" stroke-width="1.8" />
          </span>
          <div>
            <span class="eyebrow eyebrow-sun">Visit us</span>
            <h2 id="visit-us-title" class="mt-3 text-2xl md:text-3xl tracking-tight">
              Our future McKinney home
            </h2>
            <address class="mt-3 not-italic text-[var(--color-foreground)]/85 leading-relaxed">
              {SITE.address.street}<br />
              {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
            </address>
            <p class="mt-2 text-sm text-[var(--color-muted-foreground)]">
              Conveniently located just off US-75.
            </p>
          </div>
        </div>
        <a
          href={GOOGLE_DIRECTIONS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-[var(--color-primary-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 sm:justify-self-end"
          aria-label={`Get directions to ${SITE.name}`}
        >
          <Icon name="lucide:map-pin" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
          Get directions
        </a>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       FINAL CTA, "Still have questions?" pairing FAQ + Contact, instead of
       duplicating the hero. Keeps a strong close without repeating CTAs.
       ==================================================================== -->
  <section class="campaign-panel">
    <div class="brand-cloud cloud-right" aria-hidden="true"></div>
    <div class="botanical-spray leaf-right" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <SparkleField count={6} />

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 text-center">
      <div class="campaign-card px-5 py-12 md:p-14">
        <span class="eyebrow eyebrow-sun">Have a question?</span>
        <h2 class="mt-5 text-3xl md:text-5xl tracking-tight" style="font-family: var(--font-display);">
          We’re here to help your family feel informed, supported, and at ease.
        </h2>
        <StarDivider class="mt-7" span="3rem" />
        <p class="mt-7 text-base md:text-lg text-[var(--color-foreground)]/78 max-w-2xl mx-auto leading-relaxed">
          Browse our FAQs for quick answers, or reach out for general information about the future practice.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <Button href="/faq" variant="primary">
            <Icon name="lucide:info" class="w-5 h-5" stroke-width="1.6" />
            Browse FAQs
          </Button>
          <Button href="/contact" variant="secondary">
            Contact us
            <span class="btn-icon-circle" aria-hidden="true">
              <Icon name="lucide:arrow-right" class="w-4 h-4" stroke-width="1.8" />
            </span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
