---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageDecor from '../components/PageDecor.astro';
import AffiliationsStrip from '../components/AffiliationsStrip.astro';
import OfficeGallery from '../components/OfficeGallery.astro';
import Picture from '../components/Picture.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../site.config';

const principles = [
  {
    icon: 'lucide:heart',
    title: 'Family partnership',
    body: 'Children are more than a chart or checklist. We listen to the people who know them best, answer questions, and agree on a clear plan together.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Evidence-based decisions',
    body: 'Care is guided by current pediatric research and AAP and CDC recommendations, with options explained in plain language.',
  },
  {
    icon: 'lucide:users',
    title: 'Accessible, continuous care',
    body: 'Convenient scheduling, same-day sick visits, and responsive support are planned within one pediatric home from the newborn years through young adulthood.',
  },
];
const boardCertification = SITE.provider.quickFacts.find(
  ({ label }) => label === 'Board Certified',
);
const credentialFacts = SITE.provider.quickFacts.filter(
  ({ label }) => !['Board Certified', 'Care Scope'].includes(label),
);
const careScope = SITE.provider.quickFacts.find(
  ({ label }) => label === 'Care Scope',
);
---
<BaseLayout
  title="About Luma Pediatrics | McKinney Pediatrician"
  path="/about"
  description={`${SITE.name} is a board-certified, physician-led pediatric practice in McKinney, TX. ${SITE.status}, with planned care for newborns through age 21.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">About</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Care that takes the time to know your family.
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        {SITE.tagline}
      </p>
      <p class="mt-7 text-lg text-[var(--color-foreground)]/80 leading-relaxed max-w-2xl mx-auto">
        Luma Pediatrics is an independent, physician-led practice in {SITE.locationShort},
        designed for thoughtful pediatric care from the newborn years through young adulthood.
      </p>
    </div>
  </section>

  <!-- MEET THE PEDIATRICIAN -->
  <section class="provider-spotlight pt-6 pb-20 md:pt-10 md:pb-24 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={6} />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      {SITE.showProviderProfile ? (
        <div class="provider-card p-6 md:p-10 lg:p-12">
          <!-- Intro: professional headshot + first-person welcome + personal note -->
          <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] items-start">
            <div class="provider-photo-stack" aria-label={`Portrait of ${SITE.provider.name}`}>
              <Picture
                src="/images/provider-headshot.jpg"
                alt={`${SITE.provider.name}, ${SITE.provider.role} at Luma Pediatrics`}
                width={1003}
                height={1254}
                loading="lazy"
              />
            </div>

            <div>
              <span class="eyebrow">Your pediatrician</span>
              <h2 class="mt-5 text-2xl md:text-3xl lg:text-4xl tracking-tight">{SITE.provider.displayName}</h2>
              <p class="mt-3 text-lg font-semibold text-[var(--color-sage-hover)]">
                Founder and pediatrician
              </p>
              {boardCertification && (
                <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-[var(--color-muted)] px-3 py-2 text-sm font-semibold text-[var(--color-primary)] ring-1 ring-inset ring-[var(--color-border-soft)]">
                  <Icon name="lucide:shield-check" class="w-4 h-4" stroke-width="1.8" aria-hidden="true" />
                  Board certified by the {boardCertification.value}
                </p>
              )}
              <div class="mt-6 space-y-4 text-lg text-[var(--color-foreground)]/82 leading-relaxed">
                <p class="text-xl font-medium text-[var(--color-primary)]" style="font-family: var(--font-display);">
                  {SITE.provider.welcome[0]}
                </p>
                {SITE.provider.welcome.slice(1).map((para) => (
                  <p>{para}</p>
                ))}
              </div>

              <aside class="mt-7 flex items-start gap-3 rounded-2xl bg-[var(--color-muted)] p-5 ring-1 ring-inset ring-[var(--color-border-soft)]">
                <Icon name="lucide:book-open" class="mt-1 w-5 h-5 shrink-0 text-[var(--color-sage-hover)]" stroke-width="1.7" aria-hidden="true" />
                <div>
                  <h3 class="text-base font-bold">Outside the office</h3>
                  <p class="mt-2 text-sm text-[var(--color-foreground)]/80 leading-relaxed">
                    {SITE.provider.lifeOutside}
                  </p>
                </div>
              </aside>
            </div>
          </div>

          <!-- Credentials and background -->
          <div class="provider-divider mt-12 pt-12">
            <span class="eyebrow">Credentials &amp; background</span>
            <dl class="provider-facts mt-6">
              {credentialFacts.map((fact) => (
                <div class="provider-fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
            {careScope && (
              <dl class="mt-4">
                <div class="provider-fact">
                  <dt>{careScope.label}</dt>
                  <dd>{careScope.value}</dd>
                </div>
              </dl>
            )}
          </div>
        </div>
      ) : (
        <div class="provider-card grid gap-8 p-8 md:p-12 text-center">
          <div>
            <span class="eyebrow">Meet your pediatrician</span>
            <h2 class="mt-5 text-2xl md:text-3xl tracking-tight">
              Provider profile coming soon
            </h2>
            <p class="mt-6 text-lg text-[var(--color-foreground)]/82 leading-relaxed max-w-2xl mx-auto">
              Luma Pediatrics is led by a board-certified pediatrician who works closely
              with parents. Full provider profile, photo, and credentials
              will be shared on the site closer to opening day.
            </p>

            <div class="mt-8 max-w-3xl mx-auto">
              <AffiliationsStrip />
            </div>

            <div class="mt-8 flex flex-wrap gap-3 justify-center">
              <Button href="/contact/" variant="primary">Get in touch</Button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- CARE PRINCIPLES -->
  <section class="py-16 md:py-20 bg-[var(--color-muted)] reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={8} />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow eyebrow-sun">How we care</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold tracking-tight">
          Thoughtful care built around your family.
        </h2>
        <p class="mt-5 text-lg text-[var(--color-foreground)]/80 leading-relaxed">
          Luma is being designed around three commitments that guide each visit and every stage of childhood.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {principles.map(({ icon, title, body }) => (
          <article class="card-lift rounded-[var(--radius-card)] bg-[var(--color-card)] p-7">
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[var(--color-background)] text-[var(--color-primary)] mb-5 ring-1 ring-inset ring-[var(--color-border-soft)]"
              aria-hidden="true"
            >
              <Icon name={icon} class="w-6 h-6" stroke-width="1.6" />
            </span>
            <h3 class="text-xl font-bold">{title}</h3>
            <p class="mt-3 text-[var(--color-foreground)]/80 leading-relaxed">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Inside Luma office gallery - hidden until real clinic photos (SITE.showOfficeGallery) */}
  {SITE.showOfficeGallery && (
    <section class="py-16 md:py-20 reveal relative overflow-hidden">
      <PageDecor variant="minimal" sparkles={8} />
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="eyebrow eyebrow-sun">Inside Luma</span>
          <h2 class="mt-5 text-3xl md:text-4xl tracking-tight">
            A bright, calm place for kids to come.
          </h2>
          <p class="mt-5 text-[var(--color-foreground)]/80 leading-relaxed">
            The clinic will use natural light, comfortable seating, and practical details for children and parents.
          </p>
        </div>
        <OfficeGallery />
      </div>
    </section>
  )}

  <section class="py-16 md:py-20 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={5} />
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="eyebrow">Questions about Luma?</span>
      <h2 class="mt-5 text-3xl md:text-4xl tracking-tight">
        Learn more about our future practice.
      </h2>
      <p class="mt-5 text-[var(--color-foreground)]/80 leading-relaxed">
        We’re happy to answer general questions about our planned care, location, and opening updates.
      </p>
      <div class="mt-7 flex justify-center">
        <Button href="/contact/" variant="primary">Get in touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
