---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageDecor from '../components/PageDecor.astro';
import { Icon } from 'astro-icon/components';

/**
 * Luma Local Health Watch - parent-facing page.
 *
 * Reads the daily snapshot produced by the internal Luma Pediatric Pulse
 * dashboard (https://github.com/anishtallapureddy/luma-pediatric-pulse) and
 * renders a calm, plain-language version for parents.
 *
 * Source of truth lives in the Pulse repo; this page fetches at build time so
 * there are no runtime API keys, no client-side fetching, and no CORS.
 * Astro re-builds on push and via repository_dispatch from the Pulse refresh
 * job.
 */

// The GitHub raw file is the canonical copy the daily Pulse refresh job writes,
// so it is listed first. pulse.lumapediatrics.com is a CDN mirror that can lag
// or freeze; loadSnapshot() below always picks the freshest of whatever responds
// so a stale mirror can never mask newer data.
const SNAPSHOT_SOURCES = [
  'https://raw.githubusercontent.com/anishtallapureddy/luma-pediatric-pulse/main/data/snapshot.json',
  'https://pulse.lumapediatrics.com/snapshot.json',
];

type SignalLevel = 'Low' | 'Moderate' | 'High' | 'Very High' | 'Unknown';
type TrendDirection = 'Decreasing' | 'Stable' | 'Rising';
type VpdStatus =
  | 'No cases reported'
  | 'Reported cases'
  | 'Above prior-year pace'
  | 'Active outbreak'
  | 'Outbreak watch'
  | 'Sporadic'
  | 'No recent cases'
  | 'Unknown';
type SurveillanceKind = 'quantitative' | 'regional' | 'seasonal' | 'limited';

interface Snapshot {
  lastRefreshedAt?: string;
  lastUpdated: string;
  coverageArea: string[];
  airQuality: {
    currentAqi: number;
    category: string;
    primaryPollutant: string;
    source?: string;
    geography?: string;
    reportingDate?: string;
    lastUpdated?: string;
    stale?: boolean;
    staleSince?: string;
  };
  pollen: {
    treeLevel: SignalLevel;
    grassLevel: SignalLevel;
    weedLevel: SignalLevel;
    dominantAllergens: string[];
    source?: string;
    geography?: string;
    reportingDate?: string;
    lastUpdated?: string;
    stale?: boolean;
    staleSince?: string;
  };
  respiratoryIllness: {
    rsvLevel: SignalLevel;
    rsvTrend: TrendDirection;
    fluLevel: SignalLevel;
    fluTrend: TrendDirection;
    covidLevel: SignalLevel;
    covidTrend: TrendDirection;
    hospitalAdmissionTrend?: TrendDirection;
    edRespiratoryVisitTrend?: TrendDirection;
    currentHospitalizationRates?: {
      rsv: number;
      flu: number;
      covid: number;
      combined: number;
    };
    source?: string;
    geography?: string;
    reportingDate?: string;
    metric?: string;
    lastUpdated?: string;
    stale?: boolean;
    staleSince?: string;
  };
  vaccinePreventable?: {
    source?: string;
    reportingDate?: string;
    lastUpdated?: string;
    stale?: boolean;
    staleSince?: string;
    items: Array<{
      diseaseName: string;
      status: VpdStatus;
      recentCases?: number;
      geography: string;
    }>;
  };
  communityVirusWatch?: {
    source?: string;
    geography?: string;
    providerNote?: string;
    entries: Array<{
      name: string;
      category: 'respiratory' | 'gastrointestinal' | 'other-pediatric';
      level: SignalLevel;
      trend: TrendDirection;
      positivityPct?: number;
      statusLabel?: string;
      surveillanceKind?: SurveillanceKind;
      sourceName?: string;
      sourceUrl?: string;
      geography?: string;
      sourceReportingDate?: string;
      fetchedAt?: string;
      metric?: string;
      weeklyValues?: Array<{
        weekEnding: string;
        value: number;
        weeklyTestsReported?: number;
      }>;
      stale?: boolean;
      parentNote?: string;
      providerNote?: string;
    }>;
    stale?: boolean;
    lastUpdated?: string;
  };
}

function cleanExternalText(value: string) {
  return value
    .replace(/\s*\u2014\s*([a-z])/g, (_, letter: string) => `. ${letter.toUpperCase()}`)
    .replace(/\s*\u2014\s*/g, '. ');
}

function sanitizeSnapshotValue(value: unknown): unknown {
  if (typeof value === 'string') return cleanExternalText(value);
  if (Array.isArray(value)) return value.map(sanitizeSnapshotValue);
  if (value && typeof value === 'object') {
    return Object.fromEntries(
      Object.entries(value).map(([key, child]) => [key, sanitizeSnapshotValue(child)]),
    );
  }
  return value;
}

async function loadSnapshot(): Promise<Snapshot | null> {
  const results = await Promise.allSettled(
    SNAPSHOT_SOURCES.map(async (url) => {
      const res = await fetch(url, { headers: { 'cache-control': 'no-cache' } });
      if (!res.ok) throw new Error(`HTTP ${res.status} for ${url}`);
      return sanitizeSnapshotValue(await res.json()) as Snapshot;
    }),
  );

  const snapshots = results
    .filter((r): r is PromiseFulfilledResult<Snapshot> => r.status === 'fulfilled')
    .map((r) => r.value);

  if (snapshots.length === 0) return null;

  // Pick the freshest snapshot so a stale/frozen mirror can never mask a newer one.
  const freshnessOf = (s: Snapshot) =>
    new Date(s.lastRefreshedAt ?? s.lastUpdated ?? 0).getTime();
  return snapshots.reduce((freshest, cur) =>
    freshnessOf(cur) > freshnessOf(freshest) ? cur : freshest,
  );
}

const data = await loadSnapshot();

const refreshed = data?.lastRefreshedAt
  ? new Date(data.lastRefreshedAt).toLocaleString('en-US', {
      weekday: 'long',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Chicago',
    })
  : null;

/* -------- Plain-language helpers -------- */

function aqiSummary(air: Snapshot['airQuality']) {
  if (air.stale) {
    return {
      tone: 'warn' as const,
      headline: 'Latest available air-quality reading',
      sub: `AirNow did not refresh during the latest check. The last successful reading was AQI ${air.currentAqi} (${air.category}); verify current conditions with AirNow before planning outdoor activity.`,
    };
  }
  if (air.currentAqi <= 50) return { tone: 'ok' as const, headline: 'Great air outside', sub: `${air.category}. Good day for outdoor play.` };
  if (air.currentAqi <= 100) return { tone: 'warn' as const, headline: 'Air is okay for most kids', sub: `${air.category}. Children who are sensitive to air quality may benefit from lighter outdoor play.` };
  if (air.currentAqi <= 150) return { tone: 'warn' as const, headline: 'Tougher air today', sub: `${air.category}. Keep prescribed asthma rescue inhalers available.` };
  return { tone: 'alert' as const, headline: 'Air quality is poor', sub: `${air.category}. Limit prolonged outdoor exertion, especially for children with asthma or wheezing.` };
}

function pollenSummary(p: Snapshot['pollen']) {
  const rank = (l: SignalLevel) => ({ Unknown: -1, Low: 0, Moderate: 1, High: 2, 'Very High': 3 })[l] ?? -1;
  const peak = ([p.treeLevel, p.grassLevel, p.weedLevel] as SignalLevel[]).reduce<SignalLevel>(
    (max, lvl) => (rank(lvl) > rank(max) ? lvl : max),
    'Low',
  );
  const allergens = p.dominantAllergens.slice(0, 3).join(', ');
  if (p.stale) {
    return {
      tone: 'warn' as const,
      peak,
      headline: 'Latest available pollen forecast',
      sub: 'The pollen source did not refresh during the latest check. Treat these levels as the last available forecast, not today’s confirmed conditions.',
    };
  }
  if (peak === 'High' || peak === 'Very High') {
    return {
      tone: 'alert' as const,
      peak,
      headline: `${peak} pollen day`,
      sub: `${allergens || 'Common allergens'} are elevated. Follow your child's existing allergy or asthma plan and rinse off after outdoor play.`,
    };
  }
  if (peak === 'Moderate') {
    return {
      tone: 'warn' as const,
      peak,
      headline: 'Moderate pollen',
      sub: `${allergens || 'Common allergens'} are picking up. Sensitive kids may notice itchy eyes or sniffles.`,
    };
  }
  return { tone: 'ok' as const, peak, headline: 'Low pollen', sub: 'Comfortable day for outdoor play.' };
}

function respiratorySummary(r: Snapshot['respiratoryIllness']) {
  const hospitalTrend = r.hospitalAdmissionTrend ?? r.edRespiratoryVisitTrend ?? 'Stable';
  if (r.stale) {
    return {
      tone: 'warn' as const,
      headline: 'Latest available respiratory report',
      sub: 'The hospitalization source did not refresh during the latest check. Values shown are the last-known-good regional report.',
    };
  }
  const concerning =
    hospitalTrend === 'Rising' ||
    r.rsvTrend === 'Rising' ||
    r.fluTrend === 'Rising' ||
    r.covidTrend === 'Rising';

  if (concerning) {
    return {
      tone: 'warn' as const,
      headline: 'Respiratory hospitalizations are rising regionally',
      sub: 'Texas DSHS Region 2/3 is reporting an increasing hospitalization rate. This broad regional signal does not predict an individual child’s illness.',
    };
  }
  return {
    tone: 'ok' as const,
    headline: 'Respiratory hospitalizations are stable regionally',
    sub: 'Texas DSHS Region 2/3 hospitalization rates are not currently increasing. Continue usual healthy habits.',
  };
}

function vpdSummary(v: Snapshot['vaccinePreventable']) {
  if (!v) return null;
  if (v.stale) {
    return {
      tone: 'warn' as const,
      headline: 'Latest available Texas disease reports',
      sub: 'CDC NNDSS did not refresh during the latest check. The retained statewide totals are not treated as current and do not establish a local outbreak.',
    };
  }
  const abovePrior = v.items.filter(
    (i) =>
      i.status === 'Above prior-year pace' ||
      i.status === 'Active outbreak' ||
      i.status === 'Outbreak watch',
  );
  const unknown = v.items.filter((i) => i.status === 'Unknown');
  if (abovePrior.length > 0) {
    return {
      tone: 'warn' as const,
      headline: 'Some Texas reports are above last year’s pace',
      sub: 'These are provisional statewide counts, not a local outbreak determination. Ask your child’s current healthcare provider to review their vaccine record.',
    };
  }
  if (unknown.length > 0) {
    return {
      tone: 'warn' as const,
      headline: 'Some Texas provisional reports are incomplete',
      sub: 'One or more statewide disease totals were unavailable in the latest source. No local or statewide outbreak conclusion is inferred.',
    };
  }
  return {
    tone: 'ok' as const,
    headline: 'Texas provisional reports are at or below last year’s pace',
    sub: 'These statewide reports do not establish local exposure. Keep routine immunizations up to date.',
  };
}

const aqi = data ? aqiSummary(data.airQuality) : null;
const pollen = data ? pollenSummary(data.pollen) : null;
const respiratory = data ? respiratorySummary(data.respiratoryIllness) : null;
const vpd = data ? vpdSummary(data.vaccinePreventable) : null;

const virusEntries = data?.communityVirusWatch?.entries ?? [];
const virusByCategory = {
  respiratory: virusEntries.filter((v) => v.category === 'respiratory'),
  gastrointestinal: virusEntries.filter((v) => v.category === 'gastrointestinal'),
  'other-pediatric': virusEntries.filter((v) => v.category === 'other-pediatric'),
};
const VIRUS_CATEGORY_LABEL: Record<string, string> = {
  respiratory: 'Respiratory viruses',
  gastrointestinal: 'Stomach bugs',
  'other-pediatric': 'Other common pediatric viruses',
};
const virusLevelDot = (lvl: SignalLevel): string => {
  if (lvl === 'Very High' || lvl === 'High') return 'bg-[var(--color-coral)]';
  if (lvl === 'Moderate') return 'bg-[var(--color-sun)]';
  if (lvl === 'Low') return 'bg-[var(--color-sage)]';
  return 'bg-[var(--color-muted-foreground)]/50';
};
const virusDot = (entry: (typeof virusEntries)[number]): string => {
  if (entry.surveillanceKind === 'seasonal') return 'bg-[var(--color-sun)]';
  if (entry.surveillanceKind === 'regional') return 'bg-[var(--color-primary)]/70';
  if (entry.surveillanceKind === 'limited') return 'bg-[var(--color-muted-foreground)]/50';
  return virusLevelDot(entry.level);
};
const trendLabel = (trend?: TrendDirection): string => {
  if (trend === 'Rising') return 'rising';
  if (trend === 'Decreasing') return 'easing';
  return 'stable';
};
const virusStatus = (entry: (typeof virusEntries)[number]): string => {
  if (entry.statusLabel) return entry.statusLabel.replace(' - ', ' · ');
  if (typeof entry.positivityPct === 'number') {
    return `${entry.positivityPct.toFixed(1)}% positive · ${trendLabel(entry.trend)}`;
  }
  return 'Surveillance context';
};
const formatSourceDate = (value?: string): string | null => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
};
const lastAvailableDate = (section: {
  reportingDate?: string;
  lastUpdated?: string;
  staleSince?: string;
}): string | null =>
  formatSourceDate(
    section.reportingDate ?? section.lastUpdated ?? section.staleSince,
  );
const vpdStatusLabel = (status: VpdStatus): string => {
  if (status === 'Active outbreak' || status === 'Outbreak watch') return 'provisional reports';
  if (status === 'Sporadic') return 'reported cases';
  if (status === 'No recent cases') return 'no cases reported';
  return status.toLowerCase();
};

const toneClasses: Record<'ok' | 'warn' | 'alert', { bg: string; border: string; icon: string; text: string }> = {
  ok: {
    bg: 'bg-[rgba(111,128,100,0.10)]',
    border: 'border-[rgba(111,128,100,0.30)]',
    icon: 'text-[var(--color-sage-hover)] bg-[rgba(111,128,100,0.15)]',
    text: 'text-[var(--color-sage-hover)]',
  },
  warn: {
    bg: 'bg-[rgba(200,153,90,0.10)]',
    border: 'border-[rgba(200,153,90,0.35)]',
    icon: 'text-[#7a5a25] bg-[rgba(200,153,90,0.20)]',
    text: 'text-[#7a5a25]',
  },
  alert: {
    bg: 'bg-[rgba(231,108,112,0.10)]',
    border: 'border-[rgba(231,108,112,0.40)]',
    icon: 'text-[var(--color-coral)] bg-[rgba(231,108,112,0.15)]',
    text: 'text-[#a72d31]',
  },
};
---
<BaseLayout
  title="Local Health Watch | Luma Pediatrics McKinney"
  path="/health-watch"
  description="A source-transparent health snapshot for North Texas families covering air quality, pollen, respiratory hospitalizations, laboratory surveillance, and Texas provisional disease reports."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Local Health Watch', path: '/health-watch' },
  ]}
>
  <section class="page-hero py-14 md:py-20 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">For North Texas families</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Local Health Watch
      </h1>
      <p class="mt-6 tagline-italic-sage text-lg md:text-xl">
        A clearer view of this week's public-health signals.
      </p>
      <p class="mt-7 text-base md:text-lg text-[var(--color-foreground)]/80 leading-relaxed">
        Current respiratory and gastrointestinal virus activity from the best
        available public-health surveillance relevant to North Texas.
        Geographic coverage varies by virus.
      </p>
      {refreshed && (
        <p class="mt-3 text-sm text-[var(--color-muted-foreground)]">
          Data checked {refreshed} CT; source reporting schedules vary.
        </p>
      )}
    </div>
  </section>

  {!data && (
    <section class="pb-16">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-[var(--radius-card)] bg-[rgba(231,108,112,0.10)] border border-[rgba(231,108,112,0.40)] p-6 flex items-start gap-3">
          <Icon name="lucide:cloud-off" class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-coral)]" stroke-width="1.8" aria-hidden="true" />
          <div>
            <p class="font-semibold text-[var(--color-foreground)]">Snapshot temporarily unavailable</p>
            <p class="mt-1 text-sm text-[var(--color-foreground)]/80 leading-relaxed">
              We couldn't load the latest snapshot. Please check back later. For current
              medical concerns, contact your child's existing healthcare provider.
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  {data && (
    <>
      <!-- 4 plain-language cards -->
      <section class="pb-12 reveal relative overflow-hidden">
        <PageDecor variant="minimal" sparkles={6} />
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="grid gap-5 sm:grid-cols-2">
            {/* Air */}
            {aqi && (
              <article class={`rounded-[var(--radius-card)] border ${toneClasses[aqi.tone as 'ok' | 'warn' | 'alert'].bg} ${toneClasses[aqi.tone as 'ok' | 'warn' | 'alert'].border} p-6`}>
                <div class="flex items-start gap-4">
                  <span class={`inline-flex h-11 w-11 items-center justify-center rounded-2xl ${toneClasses[aqi.tone as 'ok' | 'warn' | 'alert'].icon}`}>
                    <Icon name="lucide:wind" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">Outdoor air</p>
                    <h2 class="mt-1 text-xl tracking-tight">{aqi.headline}</h2>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/85 leading-relaxed">{aqi.sub}</p>
                    <p class="mt-3 text-xs text-[var(--color-muted-foreground)]">
                      AQI {data.airQuality.currentAqi} · primary pollutant: {data.airQuality.primaryPollutant}
                    </p>
                    <p class="mt-1 text-[11px] text-[var(--color-muted-foreground)]">
                      {[data.airQuality.source, data.airQuality.geography, lastAvailableDate(data.airQuality)]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {data.airQuality.stale && (
                      <p class="mt-2 text-xs font-semibold text-[#7a5a25]">
                        Showing the last-known-good reading; current conditions may differ.
                      </p>
                    )}
                  </div>
                </div>
              </article>
            )}

            {/* Pollen */}
            {pollen && (
              <article class={`rounded-[var(--radius-card)] border ${toneClasses[pollen.tone].bg} ${toneClasses[pollen.tone].border} p-6`}>
                <div class="flex items-start gap-4">
                  <span class={`inline-flex h-11 w-11 items-center justify-center rounded-2xl ${toneClasses[pollen.tone].icon}`}>
                    <Icon name="lucide:flower-2" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">Pollen</p>
                    <h2 class="mt-1 text-xl tracking-tight">{pollen.headline}</h2>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/85 leading-relaxed">{pollen.sub}</p>
                    <p class="mt-3 text-xs text-[var(--color-muted-foreground)]">
                      Trees {data.pollen.treeLevel} · Grass {data.pollen.grassLevel} · Weeds {data.pollen.weedLevel}
                    </p>
                    <p class="mt-1 text-[11px] text-[var(--color-muted-foreground)]">
                      {[data.pollen.source, data.pollen.geography, lastAvailableDate(data.pollen)]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {data.pollen.stale && (
                      <p class="mt-2 text-xs font-semibold text-[#7a5a25]">
                        Showing the last-known-good forecast; current levels may differ.
                      </p>
                    )}
                  </div>
                </div>
              </article>
            )}

            {/* Respiratory */}
            {respiratory && (
              <article class={`rounded-[var(--radius-card)] border ${toneClasses[respiratory.tone].bg} ${toneClasses[respiratory.tone].border} p-6 sm:col-span-2`}>
                <div class="flex items-start gap-4">
                  <span class={`inline-flex h-11 w-11 items-center justify-center rounded-2xl ${toneClasses[respiratory.tone].icon}`}>
                    <Icon name="lucide:activity" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">Respiratory hospital activity</p>
                    <h2 class="mt-1 text-xl tracking-tight">{respiratory.headline}</h2>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/85 leading-relaxed">{respiratory.sub}</p>
                    {data.respiratoryIllness.currentHospitalizationRates ? (
                      <p class="mt-3 text-xs text-[var(--color-muted-foreground)]">
                        Weekly admissions per 100,000: RSV {data.respiratoryIllness.currentHospitalizationRates.rsv.toFixed(1)} ·
                        Influenza {data.respiratoryIllness.currentHospitalizationRates.flu.toFixed(1)} ·
                        COVID-19 {data.respiratoryIllness.currentHospitalizationRates.covid.toFixed(1)}
                      </p>
                    ) : (
                      <p class="mt-3 text-xs text-[var(--color-muted-foreground)]">
                        RSV {data.respiratoryIllness.rsvTrend.toLowerCase()} ·
                        Influenza {data.respiratoryIllness.fluTrend.toLowerCase()} ·
                        COVID-19 {data.respiratoryIllness.covidTrend.toLowerCase()}
                      </p>
                    )}
                    <p class="mt-1 text-[11px] text-[var(--color-muted-foreground)]">
                      {[data.respiratoryIllness.source, data.respiratoryIllness.geography, lastAvailableDate(data.respiratoryIllness)]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {data.respiratoryIllness.stale && (
                      <p class="mt-2 text-xs font-semibold text-[#7a5a25]">
                        Showing the last-known-good regional report.
                      </p>
                    )}
                  </div>
                </div>
              </article>
            )}

            {/* Vaccine-preventable */}
            {vpd && (
              <article class={`rounded-[var(--radius-card)] border ${toneClasses[vpd.tone].bg} ${toneClasses[vpd.tone].border} p-6 sm:col-span-2`}>
                <div class="flex items-start gap-4">
                  <span class={`inline-flex h-11 w-11 items-center justify-center rounded-2xl ${toneClasses[vpd.tone].icon}`}>
                    <Icon name="lucide:shield-check" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">Vaccine-preventable disease watch</p>
                    <h2 class="mt-1 text-xl tracking-tight">{vpd.headline}</h2>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/85 leading-relaxed">{vpd.sub}</p>
                    {data.vaccinePreventable && (
                      <ul class="mt-4 flex flex-wrap gap-2">
                        {data.vaccinePreventable.items.map((d) => (
                          <li class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-card)] px-3 py-1 text-xs font-medium text-[var(--color-foreground)] ring-1 ring-inset ring-[var(--color-border-soft)]">
                            <span class={`inline-block w-2 h-2 rounded-full ${
                              d.status === 'Above prior-year pace' ||
                              d.status === 'Active outbreak' ||
                              d.status === 'Outbreak watch' ? 'bg-[var(--color-sun)]' :
                              d.status === 'Reported cases' ||
                              d.status === 'Sporadic' ? 'bg-[var(--color-primary)]/60' :
                              'bg-[var(--color-sage)]'
                            }`} aria-hidden="true"></span>
                            {d.diseaseName}: <span class="text-[var(--color-muted-foreground)]">{vpdStatusLabel(d.status)}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="mt-3 text-xs text-[var(--color-muted-foreground)]">
                      CDC NNDSS · Texas provisional year-to-date reports. These
                      labels do not declare a local or statewide outbreak.
                    </p>
                    {data.vaccinePreventable?.stale && (
                      <p class="mt-2 text-xs font-semibold text-[#7a5a25]">
                        Showing the last-known-good statewide report from{' '}
                        {lastAvailableDate(data.vaccinePreventable) ?? 'the most recent successful refresh'}.
                      </p>
                    )}
                  </div>
                </div>
              </article>
            )}

            {/* Community virus watch (full 12-virus grid) */}
            {virusEntries.length > 0 && (
              <article class="rounded-[var(--radius-card)] border bg-[var(--color-card)] border-[var(--color-border-soft)] p-6 sm:col-span-2">
                <div class="flex items-start gap-4">
                  <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl text-[var(--color-primary)] bg-[rgba(60,90,160,0.10)]">
                    <Icon name="lucide:activity" class="w-5 h-5" stroke-width="1.8" aria-hidden="true" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">What's going around</p>
                    <h2 class="mt-1 text-xl tracking-tight">Community virus watch</h2>
                    <p class="mt-2 text-sm text-[var(--color-foreground)]/85 leading-relaxed">
                      Current respiratory and gastrointestinal virus activity
                      from the best available public-health surveillance
                      relevant to North Texas. Geographic coverage varies by
                      virus.
                    </p>

                    {(['respiratory', 'gastrointestinal', 'other-pediatric'] as const).map((cat) => (
                      virusByCategory[cat].length > 0 && (
                        <div class="mt-5">
                          <p class="text-[11px] uppercase tracking-[0.16em] font-semibold text-[var(--color-muted-foreground)]">{VIRUS_CATEGORY_LABEL[cat]}</p>
                          <ul class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
                            {virusByCategory[cat].map((v) => (
                              <li class={`flex items-start gap-2.5 rounded-xl px-3 py-3 ring-1 ring-inset ring-[var(--color-border-soft)] ${
                                v.surveillanceKind === 'seasonal'
                                  ? 'bg-[rgba(200,153,90,0.08)]'
                                  : v.surveillanceKind === 'limited' || v.surveillanceKind === 'regional'
                                    ? 'bg-[rgba(11,29,58,0.035)]'
                                    : 'bg-[var(--color-background)]'
                              }`}>
                                <span class={`inline-block w-2.5 h-2.5 rounded-full mt-1.5 shrink-0 ${virusDot(v)}`} aria-hidden="true"></span>
                                <div class="min-w-0 flex-1">
                                  <p class="text-sm font-semibold text-[var(--color-foreground)]">{v.name}</p>
                                  <p class="mt-0.5 text-sm font-medium text-[var(--color-foreground)]/85">
                                    {virusStatus(v)}
                                  </p>
                                  {v.parentNote && (
                                    <p class="mt-1 text-xs text-[var(--color-muted-foreground)] leading-relaxed">{v.parentNote}</p>
                                  )}
                                  {(v.sourceName || v.geography || v.sourceReportingDate) && (
                                    <p class="mt-2 text-[10px] text-[var(--color-muted-foreground)] leading-relaxed">
                                      {v.sourceUrl && v.sourceName ? (
                                        <a
                                          href={v.sourceUrl}
                                          target="_blank"
                                          rel="noopener noreferrer"
                                          class="underline decoration-transparent hover:decoration-current focus-visible:decoration-current"
                                        >
                                          {v.sourceName}
                                        </a>
                                      ) : (
                                        v.sourceName
                                      )}
                                      {v.sourceName && v.geography ? ' · ' : ''}
                                      {v.geography}
                                      {(v.sourceName || v.geography) && v.sourceReportingDate ? ' · ' : ''}
                                      {formatSourceDate(v.sourceReportingDate)}
                                      {v.stale ? ' · showing last-known-good value' : ''}
                                    </p>
                                  )}
                                  {v.metric && (
                                    <p class="mt-1 text-[10px] text-[var(--color-muted-foreground)] leading-relaxed">
                                      Metric: {v.metric}
                                    </p>
                                  )}
                                  {v.weeklyValues && v.weeklyValues.length > 1 && (
                                    <details class="mt-2 text-[11px] text-[var(--color-muted-foreground)]">
                                      <summary class="cursor-pointer font-medium text-[var(--color-primary)]">
                                        Recent weekly values
                                      </summary>
                                      <div class="mt-2 flex flex-wrap gap-1.5">
                                        {v.weeklyValues.map((point) => (
                                          <span class="rounded-full bg-[var(--color-card)] px-2 py-1 ring-1 ring-inset ring-[var(--color-border-soft)]">
                                            {formatSourceDate(point.weekEnding)}: {point.value.toFixed(1)}%
                                            {typeof point.weeklyTestsReported === 'number'
                                              ? ` centered 3-week average · ${point.weeklyTestsReported.toLocaleString('en-US')} tests reported for that week`
                                              : ''}
                                          </span>
                                        ))}
                                      </div>
                                    </details>
                                  )}
                                </div>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )
                    ))}
                    <p class="mt-4 text-xs text-[var(--color-muted-foreground)]">
                      Sources include CDC NREVSS, CDC national respiratory
                      laboratory surveillance, and Texas public-health
                      surveillance. Data checked daily; source reporting
                      schedules vary.{data.communityVirusWatch?.stale ? ' Some cards are showing their last-known-good values.' : ''}
                    </p>
                    <p class="mt-2 text-xs text-[var(--color-muted-foreground)]">
                      Percentages represent laboratory tests, not the percentage
                      of children who are ill. Community surveillance is
                      informational and does not predict an individual child’s
                      illness.
                    </p>
                  </div>
                </div>
              </article>
            )}
          </div>
        </div>
      </section>

      <!-- Parent CTAs -->
      <section class="pb-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-[var(--radius-card)] bg-[var(--color-card)] ring-1 ring-[var(--color-border-soft)] p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
              <div class="max-w-2xl">
                <h2 class="text-2xl tracking-tight">Have a question about today?</h2>
                <p class="mt-2 text-[var(--color-foreground)]/80 leading-relaxed">
                  Wheezing, fever, persistent cough, vaccine catch-up, or just unsure? Use this
                  information to prepare questions for your child's current healthcare provider.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-6 rounded-xl bg-[rgba(11,29,58,0.04)] border border-[var(--color-border-soft)] p-4 flex items-start gap-3">
            <Icon name="lucide:info" class="w-5 h-5 mt-0.5 shrink-0 text-[var(--color-primary)]" stroke-width="1.8" aria-hidden="true" />
            <p class="text-sm text-[var(--color-foreground)]/85 leading-relaxed">
              <strong>This is general guidance for our community, not medical advice for your child.</strong>
              We use public data from EPA AirNow, Google Pollen, CDC, and Texas
              DSHS. Geography and reporting dates are shown with each signal.
              For concerns specific to your child, contact their current
              healthcare provider.
            </p>
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>
