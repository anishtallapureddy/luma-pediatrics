---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageDecor from '../../components/PageDecor.astro';
import { Icon } from 'astro-icon/components';

const sections = [
  {
    href: '/health-watch/',
    eyebrow: 'Local conditions',
    title: 'Health Watch',
    body:
      'A daily snapshot of air quality, pollen, and respiratory illness activity across North Texas, written in plain language for parents.',
    icon: 'lucide:activity',
  },
  {
    href: '/dosing-charts/',
    eyebrow: 'Quick reference',
    title: 'Dosing Charts',
    body:
      'Weight-based acetaminophen and ibuprofen dosing tables for children, with clear age, weight, and dose guidance.',
    icon: 'lucide:pill',
  },
  {
    href: '/vaccines/',
    eyebrow: 'Prevention',
    title: 'Vaccine Schedule',
    body:
      'A parent-friendly view of the AAP childhood immunization schedule from birth through adolescence.',
    icon: 'lucide:syringe',
  },
  {
    href: '/blog/',
    eyebrow: 'Articles',
    title: 'Blog & Parent Guides',
    body:
      'Pediatric information on newborn care, fevers, sleep, vaccines, and common parent questions.',
    icon: 'lucide:book-open',
  },
];
---
<BaseLayout
  title="Resources for Parents"
  description="Health Watch, dosing charts, and parent guides from Luma Pediatrics: practical references for North Texas families."
  path="/resources/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources/' },
  ]}
>
  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">Resources</span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        Practical information for parents
      </h1>
      <p class="mt-6 text-lg text-[var(--color-foreground)]/80 leading-relaxed max-w-2xl mx-auto">
        Quick references, local health updates, and parent guides in one place.
      </p>
    </div>
  </section>

  <section class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 md:pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {sections.map(({ href, eyebrow, title, body, icon }) => (
        <a
          href={href}
          class="group rounded-[var(--radius-card)] bg-[var(--color-card)] p-7 card-lift no-underline border border-[var(--color-border-soft)] flex flex-col"
        >
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] mb-4" aria-hidden="true">
            <Icon name={icon} class="w-6 h-6" stroke-width="1.6" />
          </span>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-sage-hover)]">{eyebrow}</p>
          <h2 class="mt-2 text-2xl font-semibold text-[var(--color-foreground)]" style="font-family: var(--font-display);">{title}</h2>
          <p class="mt-3 text-[var(--color-foreground)]/80 leading-relaxed flex-1">{body}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-[var(--color-primary)] font-medium">
            Explore
            <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" stroke-width="1.8" aria-hidden="true" />
          </span>
        </a>
      ))}
    </div>

    <a
      href="/new-patients/"
      class="group mt-6 flex items-center gap-4 rounded-[var(--radius-card)] bg-[var(--color-card)] p-5 card-lift no-underline border border-[var(--color-border-soft)]"
    >
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-muted)] text-[var(--color-primary)]" aria-hidden="true">
        <Icon name="lucide:clipboard-check" class="w-5 h-5" stroke-width="1.7" />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-sage-hover)]">
          Planning ahead
        </span>
        <strong class="mt-1 block text-lg text-[var(--color-foreground)]">
          Future new-patient guide
        </strong>
        <span class="mt-1 block text-sm text-[var(--color-muted-foreground)]">
          What families can expect and bring when scheduling opens.
        </span>
      </span>
      <Icon name="lucide:arrow-right" class="w-5 h-5 shrink-0 text-[var(--color-primary)] transition-transform group-hover:translate-x-0.5" stroke-width="1.8" aria-hidden="true" />
    </a>
  </section>
</BaseLayout>
