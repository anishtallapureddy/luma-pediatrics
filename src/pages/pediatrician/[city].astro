---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PageDecor from '../../components/PageDecor.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import { Icon } from 'astro-icon/components';
import { CITIES } from '../../data/cities.ts';
import { featuredServices } from '../../data/services';
import { GOOGLE_DIRECTIONS_URL, SITE, STRUCTURED_DATA_IDS } from '../../site.config';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

const { city } = Astro.props;

const title = city.slug === 'mckinney'
  ? 'Pediatrician in McKinney, TX'
  : `Pediatrician Near ${city.name}, TX`;
const description = city.slug === 'mckinney'
  ? "Explore Luma Pediatrics' future McKinney practice, planned services for newborns through teens, location details, and opening updates."
  : `Pediatrician near ${city.name}, TX: Luma Pediatrics' future McKinney clinic is about ${city.distanceMi} miles away. Explore planned services, travel details, and updates.`;
const pageUrl = `${SITE.domain}/pediatrician/${city.slug}/`;
const directionsUrl =
  `${GOOGLE_DIRECTIONS_URL}&origin=${encodeURIComponent(`${city.name}, TX`)}`;
const locationAnswer = city.slug === 'mckinney'
  ? `${SITE.name} will have one clinic at ${SITE.address.street}, ${SITE.address.city}, ${SITE.address.region} ${SITE.address.postalCode}.`
  : `${SITE.name} will have one clinic in McKinney, about ${city.distanceMi} miles from central ${city.name}. This page describes travel to that McKinney location, not a separate ${city.name} office.`;
const faqItems = [
  {
    question: `Where is Luma Pediatrics relative to ${city.name}?`,
    answer: locationAnswer,
  },
  {
    question: `How long is the drive from ${city.name} to Luma Pediatrics?`,
    answer:
      city.distanceMi === 0
        ? 'The future clinic is in McKinney, just off US-75. Drive time will vary by neighborhood and traffic.'
        : `The estimated drive from central ${city.name} is ${city.driveMinutes}. Actual travel time will vary by starting point and traffic.`,
  },
  {
    question: 'Is Luma Pediatrics open and scheduling appointments?',
    answer: `${SITE.status}. The practice is not currently open, accepting patients, or scheduling appointments.`,
  },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#pediatric-primary-care`,
  name: `Planned pediatric primary care for ${city.name} families`,
  serviceType: 'Pediatric primary care',
  provider: { '@id': STRUCTURED_DATA_IDS.clinic },
  areaServed: {
    '@type': 'City',
    name: city.name,
    containedInPlace: { '@type': 'State', name: 'Texas' },
  },
  url: pageUrl,
  description,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  path={`/pediatrician/${city.slug}/`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Service area', path: '/pediatrician/' },
    { name: city.name, path: `/pediatrician/${city.slug}/` },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero py-12 md:py-16 overflow-hidden">
    <PageDecor />
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <span class="eyebrow">
        Future service area · {city.name}, TX
      </span>
      <h1 class="mt-5 text-4xl md:text-5xl tracking-tight">
        {city.slug === 'mckinney'
          ? 'A future pediatric home in McKinney'
          : `A future pediatric option for ${city.name} families`}
      </h1>
      <p class="mt-6 text-lg md:text-xl text-[var(--color-foreground)]/80 max-w-2xl mx-auto">
        {city.intro}
      </p>
      {city.distanceMi > 0 && (
        <p class="mt-3 text-sm text-[var(--color-muted-foreground)]">
          <Icon name="lucide:map-pin" class="inline w-4 h-4 -mt-0.5" />
          About {city.distanceMi} miles from central {city.name} · {city.driveMinutes} drive to our future McKinney clinic
        </p>
      )}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="#practice-updates" variant="primary">
          Get Luma updates
        </Button>
        <Button href="/about/" variant="secondary">About Luma</Button>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 reveal relative overflow-hidden">
    <PageDecor variant="minimal" sparkles={5} />
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.85fr)] lg:items-start">
      <div>
        <h2 class="text-2xl md:text-3xl font-display text-[var(--color-foreground)] mb-4">
          Built for the {city.name} community
        </h2>
        <p class="text-[var(--color-foreground)]/80 mb-6 leading-relaxed">{city.whyLuma}</p>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-muted-foreground)] mb-3">
          Familiar places near {city.name}
        </p>
        <ul class="flex flex-wrap gap-2">
          {city.landmarks.map((lm) => (
            <li class="px-3 py-1.5 rounded-full bg-[var(--color-muted)] text-[var(--color-primary)] text-sm">
              {lm}
            </li>
          ))}
        </ul>
      </div>

      <aside class="rounded-[var(--radius-card)] bg-[var(--color-card)] border border-[var(--color-border-soft)] p-6 shadow-[var(--shadow-soft)]">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-sage-hover)]">
          Plan a future visit
        </p>
        <h2 class="mt-2 text-2xl font-display text-[var(--color-foreground)]">
          From {city.name} to McKinney
        </h2>
        <p class="mt-3 text-sm text-[var(--color-foreground)]/75 leading-relaxed">
          {locationAnswer}
        </p>
        <dl class="mt-5 grid gap-3 text-sm">
          <div class="flex items-start justify-between gap-4">
            <dt class="font-semibold text-[var(--color-foreground)]">Distance</dt>
            <dd class="text-right text-[var(--color-foreground)]/75">
              {city.distanceMi === 0 ? 'In McKinney' : `About ${city.distanceMi} miles`}
            </dd>
          </div>
          <div class="flex items-start justify-between gap-4">
            <dt class="font-semibold text-[var(--color-foreground)]">Typical drive</dt>
            <dd class="text-right text-[var(--color-foreground)]/75">{city.driveMinutes}</dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-foreground)]">Future clinic</dt>
            <dd class="mt-1 text-[var(--color-foreground)]/75">
              <address class="not-italic">
                {SITE.address.street}<br />
                {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}
              </address>
            </dd>
          </div>
        </dl>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-5 text-sm font-semibold text-white no-underline hover:bg-[var(--color-primary-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
          aria-label={`Get directions from ${city.name} to ${SITE.name}`}
        >
          <Icon name="lucide:map-pin" class="w-4 h-4" stroke-width="2" aria-hidden="true" />
          Get directions
        </a>
      </aside>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-[var(--color-muted)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-display text-[var(--color-foreground)] mb-8 text-center">
        Care we'll offer {city.name} families
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredServices.slice(0, 6).map((svc) => (
          <a href={`/services/#${svc.slug}`} class="card-lift block p-5 rounded-[var(--radius-card)] bg-[var(--color-card)] text-[var(--color-foreground)] no-underline">
            <h3 class="font-semibold text-[var(--color-foreground)] mb-1">{svc.title}</h3>
            <p class="text-sm text-[var(--color-foreground)]/70">{svc.short}</p>
          </a>
        ))}
      </div>
      <p class="text-center mt-6">
        <a href="/services/" class="text-[var(--color-primary)] hover:underline font-medium">See all services →</a>
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-sage-hover)]">
        Planning ahead
      </p>
      <h2 class="mt-2 text-2xl md:text-3xl font-display text-[var(--color-foreground)]">
        Questions from {city.name} families
      </h2>
      <div class="mt-6 space-y-3">
        {faqItems.map((item) => (
          <details class="rounded-[var(--radius-card)] border border-[var(--color-border-soft)] bg-[var(--color-card)] p-5">
            <summary class="cursor-pointer font-semibold text-[var(--color-foreground)]">
              {item.question}
            </summary>
            <p class="mt-3 text-sm text-[var(--color-foreground)]/75 leading-relaxed">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <WaitlistForm variant="hero" />
    </div>
  </section>
</BaseLayout>
